# --------------------------------------------------------------------------------------------------------- sysfs probes
def gpu_targets():
    found = []
    for props in sorted(glob.glob(str(sysp('/sys/class/kfd/kfd/topology/nodes')) + '/*/properties')):
        m = re.search(r'^gfx_target_version (\d+)$', read(props, ''), re.M)
        if m and int(m[1]):
            v = int(m[1])
            found.append(f'gfx{v // 10000}{(v // 100) % 100}{v % 100:x}')
    return found


def meminfo():
    info = {}
    for line in (read(sysp('/proc/meminfo'), '') or '').splitlines():
        key, _, rest = line.partition(':')
        try:
            info[key] = int(rest.split()[0]) * 1024
        except (IndexError, ValueError):
            pass
    return info


def gb_per_lane(text):
    m = re.match(r'\s*([0-9.]+)\s*Gb/s', text or '')
    return float(m[1]) if m else None


def usb4_links():
    """Every XDomain / device link the Thunderbolt bus reports, with per-direction speed (Gb/s per lane) and lanes."""
    links = []
    for d in sorted(glob.glob(str(sysp('/sys/bus/thunderbolt/devices')) + '/*')):
        name = os.path.basename(d)
        if not re.fullmatch(r'\d+-[0-9a-f]+', name) or name.endswith('-0'):
            continue  # host routers (N-0) and services (N-R.S) are not links
        rx, tx = gb_per_lane(read(d + '/rx_speed')), gb_per_lane(read(d + '/tx_speed'))
        if rx is None and tx is None:
            continue
        links.append({'name': name, 'peer': read(d + '/device_name', '?'), 'rx': rx, 'tx': tx,
                      'rx_lanes': int(read(d + '/rx_lanes', '0') or 0), 'tx_lanes': int(read(d + '/tx_lanes', '0') or 0)})
    return links


def link_verdict(link):
    """(level, text) for one link: Gen3 x2 = 20 Gb/s per lane on 2 lanes in both directions."""
    def g(v):
        return '?' if v is None else f'{v:g}'
    desc = (f'{link["name"]} to {link["peer"]}: rx {g(link["rx"])} Gb/s x{link["rx_lanes"]}, '
            f'tx {g(link["tx"])} Gb/s x{link["tx_lanes"]}')
    speeds = [s for s in (link['rx'], link['tx']) if s is not None]
    lanes = (link['rx_lanes'], link['tx_lanes'])
    if speeds and min(speeds) >= 20 and min(lanes) >= 2:
        return 'PASS', desc + ' (Gen3 x2, 40 Gb/s per direction)'
    if speeds and min(speeds) < 20:
        return 'WARN', desc + ' - trained at Gen2: re-seat that cable with both nodes on'
    return 'WARN', desc + ' - single lane: re-seat that cable with both nodes on'


def stream_devices():
    return sorted(glob.glob(str(sysp('/dev')) + '/tbstream*'))


def module_loaded(name):
    return sysp(f'/sys/module/{name}').is_dir()


def nhi_devices():
    """PCI USB4 host interfaces (class 0x0c0340) with their IOMMU group type and driver."""
    found = []
    for d in sorted(glob.glob(str(sysp('/sys/bus/pci/devices')) + '/*')):
        if read(d + '/class', '') != '0x0c0340':
            continue
        group = os.path.realpath(d + '/iommu_group') if os.path.exists(d + '/iommu_group') else None
        found.append({'pci': os.path.basename(d), 'type': read(group + '/type', '?') if group else None,
                      'driver': os.path.basename(os.path.realpath(d + '/driver')) if os.path.exists(d + '/driver') else None})
    return found


def kernel_config():
    """The running kernel's configuration text (from /boot or /proc/config.gz), or None."""
    release = platform.release()
    text = read(sysp(f'/boot/config-{release}'))
    if text:
        return text, str(sysp(f'/boot/config-{release}'))
    gz = sysp('/proc/config.gz')
    if gz.is_file():
        import gzip
        try:
            return gzip.decompress(gz.read_bytes()).decode('utf-8', 'replace'), str(gz)
        except OSError:
            pass
    return None, None


def rocm_root(cfg):
    if cfg.get('ROCM_PATH'):
        return Path(cfg['ROCM_PATH'])
    r = out(['hipconfig', '-R'])
    if r and Path(r.splitlines()[0]).is_dir():
        return Path(r.splitlines()[0])
    return Path(os.environ.get('ROCM_PATH', '/opt/rocm'))


def hip_compiler(rocm):
    for rel in ('lib/llvm/bin/clang++', 'llvm/bin/clang++', 'bin/amdclang++'):
        if (rocm / rel).is_file():
            return rocm / rel
    return None


def version_tuple(text):
    return tuple(int(x) for x in re.findall(r'\d+', text or '')[:3])


def ssh_argv(cfg, command):
