def git_checkout(url, commit, dest):
    """Clone URL into DEST (once) and check out COMMIT; no-op when already there."""
    dest = Path(dest)
    if not (dest / '.git').is_dir():
        dest.parent.mkdir(parents=True, exist_ok=True)
        run(['git', 'clone', '--quiet', url, dest])
    head = out(['git', '-C', str(dest), 'rev-parse', 'HEAD'])
    if head != commit:
        if run(['git', '-C', dest, 'cat-file', '-e', commit + '^{commit}'], check=False, show=False).returncode:
            run(['git', '-C', dest, 'fetch', '--quiet', 'origin', commit])
        run(['git', '-C', dest, 'checkout', '--quiet', '--detach', commit])
    return dest


def linux_tree(deps):
    """The pinned upstream tree with the driver series applied (downloaded and verified once)."""
    tree = deps / f'linux-{LINUX_COMMIT[:12]}'
    stamp = tree / '.ds41-pair-series'
    driver = deps / 'strix-halo-usb4-driver'
    series = [l.split('#')[0].strip() for l in (driver / 'patches' / 'series').read_text().splitlines()]
    series = [l for l in series if l]
    want = DRIVER_COMMIT + ' ' + ' '.join(series)
    if stamp.is_file() and stamp.read_text().strip() == want:
        return tree
    if stamp.is_file():
        print(f'the driver pin changed: preparing {tree.name} again', flush=True)
        shutil.rmtree(tree)  # our own patched tree of an older pin (it carries our stamp)
    elif tree.exists():
        die(f'{tree} exists but was not prepared by ds41-pair; move it away and re-run')
    # A shallow fetch of the pinned commit (its id pins the content), as in the driver README; once per DEPS_DIR.
    tmp = deps / f'.linux-{LINUX_COMMIT[:12]}.incomplete'
    if tmp.exists() and not (tmp / '.git').is_dir():
        shutil.rmtree(tmp)  # interrupted after the patches were applied: start over
    if not (tmp / '.git').is_dir():
        tmp.mkdir(parents=True, exist_ok=True)
        run(['git', '-C', tmp, 'init', '--quiet'])
    if out(['git', '-C', str(tmp), 'rev-parse', 'HEAD']) != LINUX_COMMIT:
        print('fetching the pinned kernel tree (about 250 MB, once)', flush=True)
        run(['git', '-C', tmp, 'fetch', '--quiet', '--depth', '1', LINUX_GIT, LINUX_COMMIT])
        run(['git', '-C', tmp, 'checkout', '--quiet', '--detach', 'FETCH_HEAD'])
    if out(['git', '-C', str(tmp), 'rev-parse', 'HEAD']) != LINUX_COMMIT:
        die('the fetched kernel tree is not the pinned commit')
    # an interrupted earlier apply starts clean (also files the patches added)
    run(['git', '-C', tmp, 'reset', '--quiet', '--hard'], show=False)
    run(['git', '-C', tmp, 'clean', '-q', '-fdx'], show=False)
    for p in series:
        run(['git', 'apply', '--check', driver / 'patches' / p], cwd=tmp, show=False)
        run(['git', 'apply', driver / 'patches' / p], cwd=tmp, show=False)
    print(f'applied the {len(series)} driver patches', flush=True)
    shutil.rmtree(tmp / '.git')  # a Git tree would make the kernel version end in '+' and the modules refuse to load
    tmp.replace(tree)
    stamp.write_text(want + '\n')
    return tree


def stream_module_current():
    """The loaded stream module has the newest configfs attributes of the pinned series (0048 batching budgets)."""
    return module_loaded('thunderbolt_stream') and bool(
        glob.glob(str(sysp('/sys/kernel/config/thunderbolt/stream')) + '/*/*/rx_repost_batch'))


def system_settings(staged):
    """Root steps for the memory settings the pair needs (driver NODE-SETUP section 4), only where missing."""
    steps, notes = [], []
    limit = read(sysp('/sys/module/ttm/parameters/pages_limit'))
    if not limit or int(limit or 0) < TTM_PAGES_LIMIT * 9 // 10:
        (staged / 'ttm.conf').write_text(f'# GTT limit for the DeepSeek pair: {TTM_PAGES_LIMIT} pages x 4 KiB = 117 GiB\n'
                                         f'options ttm pages_limit={TTM_PAGES_LIMIT}\n')
        steps.append(['install', '-m', '0644', staged / 'ttm.conf', '/etc/modprobe.d/ttm.conf'])
        notes.append('ttm.conf takes effect at the next boot; rebuild the initramfs if it loads ttm '
                     '(update-initramfs -u or dracut -f); if ttm is built in, add ttm.pages_limit= to the command line')
    if 'kho=off' not in (read(sysp('/proc/cmdline'), '') or '').split():
        if sysp('/etc/default/grub.d').is_dir():
            (staged / '50-strix-pair-kho.cfg').write_text(
                '# keep the Kexec HandOver scratch memory available to the GPU\n'
                'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT kho=off"\n')
            steps += [['install', '-m', '0644', staged / '50-strix-pair-kho.cfg', '/etc/default/grub.d/50-strix-pair-kho.cfg'],
                      ['update-grub']]
        else:
            notes.append('add kho=off to the kernel command line with your boot loader')
    return steps, notes


def root_steps(args, steps, notes, then):
    print('\nRoot steps (run them yourself on THIS node, or re-run with --yes-root to run them one by one):')
    for s in steps:
        print('  sudo ' + shlex.join(map(str, s)))
    for n in notes:
        print('  note: ' + n)
    if args.yes_root and not args.dry_run and steps:
        for s in steps:
            print('\n+ sudo ' + shlex.join(map(str, s)), flush=True)
            if subprocess.run(['sudo'] + list(map(str, s))).returncode != 0:
                die('root step failed; fix it and re-run ds41-pair driver --yes-root (the steps are idempotent)')
        print('\nroot steps done.')
    print(then)


def configure_tree(tree, driver, config_text, localversion, jobs):
    (tree / '.config').write_text(config_text)
    run(['scripts/kconfig/merge_config.sh', '-m', '.config', driver / 'config' / 'usb4-gpu.fragment'], cwd=tree,
        capture=True)
    run(['scripts/config', '--file', '.config', '--set-str', 'LOCALVERSION', localversion,
         '--disable', 'LOCALVERSION_AUTO'], cwd=tree)
    run(['make', '-j', jobs, 'olddefconfig'], cwd=tree, capture=True)
    for opt in ('CONFIG_USB4', 'CONFIG_USB4_STREAM'):
        if not re.search(rf'^{opt}=[my]', (tree / '.config').read_text(), re.M):
            die(f'{opt} is not enabled after merging the driver fragment (a dependency is missing in your kernel '
                'configuration, see the driver repository BUILD.md)')


def cmd_driver(args):
    cfg = load_config(args)
    deps = Path(cfg['DEPS_DIR'])
    release = platform.release()
    jobs = str(args.jobs or os.cpu_count() or 8)
    print(f'ds41-pair driver: USB4 stream driver for this node (running kernel {release})')
    staged = deps / 'usb4-modules' / release
    staged.mkdir(parents=True, exist_ok=True)
    settings, notes = system_settings(staged)
    if stream_module_current() and not (args.rebuild or args.kernel):
        say('PASS', 'driver', 'the running kernel already has the series\' stream module (thunderbolt_stream srcversion '
            f'{read(sysp("/sys/module/thunderbolt_stream/srcversion"), "?")}): nothing to build (--rebuild forces it)')
        if settings:
            root_steps(args, settings, notes, 'Then reboot, and run ds41-pair driver-verify on both nodes.')
        else:
            print('Next: ds41-pair driver-verify (on both nodes)')
        return 0
    for tool in ('git', 'make', 'gcc', 'flex', 'bison', 'bc'):
        if not shutil.which(tool):
            die(f'{tool} is missing (kernel builds need: build-essential flex bison bc libelf-dev libssl-dev dwarves)')
    config_text, config_src = kernel_config()
    if not config_text:
        die(f'no configuration of the running kernel (/boot/config-{release} or /proc/config.gz)')
    driver = git_checkout(DRIVER_GIT, DRIVER_COMMIT, deps / 'strix-halo-usb4-driver')
    tree = linux_tree(deps)
    kver = out(['make', '-s', '-C', str(tree), 'kernelversion'], timeout=120)
    same = bool(kver) and (release == kver or release.startswith(kver + '-') or release.startswith(kver + '+'))
    builtin = bool(re.search(r'^CONFIG_USB4=y', config_text, re.M))
    if args.kernel or not same or builtin:
        return driver_kernel(args, cfg, deps, driver, tree, kver, release, config_text, config_src, jobs,
                             settings, notes, same, builtin)
    return driver_modules(args, deps, driver, tree, kver, release, config_text, config_src, jobs, staged,
                          settings, notes)


def driver_modules(args, deps, driver, tree, kver, release, config_text, config_src, jobs, staged, settings, notes):
    """The running kernel is the series' version: build the three modules against it (no new kernel)."""
    local = release[len(kver):]
    symvers = sysp(f'/lib/modules/{release}/build/Module.symvers')
    whole = args.full or not symvers.is_file()
    say('PASS', 'driver', f'series {DRIVER_COMMIT[:12]} applies to Linux {kver}, the version of the running kernel')
    print(f'modules for {release}: .config from {config_src} + the driver fragment, LOCALVERSION={local!r}, '
          + ('the whole kernel tree once (no Module.symvers from linux-headers; 30-60 min)' if whole
             else "modules_prepare with the running kernel's Module.symvers")
          + ', then drivers/thunderbolt and drivers/net/thunderbolt')
    built = [tree / 'drivers/thunderbolt/thunderbolt.ko', tree / 'drivers/thunderbolt/thunderbolt_stream.ko',
             tree / 'drivers/net/thunderbolt/thunderbolt_net.ko']
    if args.dry_run:
        return 0
    stamp = tree / '.ds41-pair-built'
    if args.rebuild or read(stamp) != release or not all(p.is_file() for p in built):
        configure_tree(tree, driver, config_text, local, jobs)
        if whole:
            run(['make', '-j', jobs], cwd=tree, capture=True)
        else:
            run(['make', '-j', jobs, 'modules_prepare'], cwd=tree, capture=True)
            shutil.copyfile(symvers, tree / 'Module.symvers')
        run(['make', '-j', jobs, 'M=drivers/thunderbolt', 'modules'], cwd=tree, capture=True)
        run(['make', '-j', jobs, 'M=drivers/net/thunderbolt', 'modules'], cwd=tree, capture=True)
        stamp.write_text(release + '\n')
    sums = []
    for ko in built:
        magic = (out(['modinfo', '-F', 'vermagic', str(ko)]) or '').split()
        if not magic or magic[0] != release:
            die(f'{ko.name} was built for {magic[0] if magic else "?"}, not {release}; re-run with --rebuild')
        shutil.copyfile(ko, staged / ko.name)
        sums.append(f'{sha256(staged / ko.name)}  {ko.name}')
    (staged / 'SHA256SUMS').write_text(''.join(line + chr(10) for line in sums))
    src = out(['modinfo', '-F', 'srcversion', str(staged / 'thunderbolt_stream.ko')])
    say('PASS', 'driver', f'modules staged in {staged} (vermagic {release}; thunderbolt_stream srcversion {src}; '
        'record it: driver-verify compares the loaded module with it)')
    group = out(['id', '-gn']) or 'render'
    (staged / '70-strix-tbstream.rules').write_text(
        '# USB4 stream devices of the DeepSeek pair: read/write for the group that runs the engine\n'
        f'KERNEL=="tbstream*", MODE="0660", GROUP="{group}"\n')
    (staged / 'strix-usb4.conf').write_text(
        '# thunderbolt_net would take one data ring pair per controller away from the USB4 streams\n'
        'blacklist thunderbolt_net\n')
    (staged / 'usb4stream-pair.service').write_text(
        '[Unit]\nDescription=Prepare two USB4STREAM channels per USB4 port (DeepSeek pair)\n'
        'After=systemd-modules-load.service\n\n[Service]\nType=oneshot\n'
        'ExecStart=/usr/local/sbin/setup-usb4stream-lab\nRemainAfterExit=yes\nTimeoutStartSec=60\n\n'
        '[Install]\nWantedBy=multi-user.target\n')
    secure_boot_note()
    mods = f'/lib/modules/{release}/updates/strix-usb4'
    steps = [['install', '-D', '-m', '0644', staged / ko.name, f'{mods}/{ko.name}'] for ko in built]
    steps += [['depmod', '-a', release]] + lab_file_steps(driver, staged) + settings + [
        ['install', '-m', '0644', staged / 'usb4stream-pair.service', '/etc/systemd/system/usb4stream-pair.service'],
        ['systemctl', 'daemon-reload'], ['systemctl', 'enable', 'usb4stream-pair.service']]
    notes = notes + ['the initramfs must not carry thunderbolt_stream (lsinitramfs); if it does, rebuild it after '
                     'depmod, or the boot loads the old copy']
    root_steps(args, steps, notes, 'Then reboot (the new modules load at boot; a running module is never swapped), '
               'and run ds41-pair driver-verify on both nodes.')
    return 0


def driver_kernel(args, cfg, deps, driver, tree, kver, release, config_text, config_src, jobs, settings, notes,
                  same, builtin):
    """Another kernel version (or USB4 built in): build the whole patched kernel as a package next to the current one."""
    why = ('the running kernel has USB4 built in (CONFIG_USB4=y)' if builtin
           else f'the running kernel is {release}, the series is for Linux {kver}' if not same else '--kernel given')
    local = args.localversion or ('-strix-gpu-bosgame-pair' + DRIVER_COMMIT[:8])
    newrel = kver + local
    say('INFO' if args.kernel else 'WARN', 'driver', ('' if same and not builtin else f'{why}: modules for it cannot be '
        'built. ') + f'The route is a new kernel {newrel} from the pinned tree with the driver series, installed next '
        'to the current one (kept as the fallback boot entry); about 30-60 min of compiling, no root until the install.')
    if not args.kernel:
        print('Re-run as ds41-pair driver --kernel to build it (--dry-run shows the plan first), or follow the driver '
              'repository BUILD.md by hand.')
        return 1
    deb = bool(shutil.which('dpkg-deb'))
    print(f'plan: .config from {config_src} + the driver fragment, LOCALVERSION={local!r}, olddefconfig, the driver\'s '
          f'check_kconfig.py, then make {"bindeb-pkg (Debian packages)" if deb else "(whole tree)"} in {tree}')
    if args.dry_run:
        return 0
    if sysp(f'/lib/modules/{newrel}').exists():
        die(f'/lib/modules/{newrel} exists already: pass a new --localversion so an installed kernel is never overwritten')
    configure_tree(tree, driver, config_text, local, jobs)
    run([sys.executable, driver / 'tools' / 'check_kconfig.py', tree / '.config', '--kernelrelease', newrel], cwd=tree)
    run(['make', '-j', jobs, 'bindeb-pkg' if deb else 'all'], cwd=tree, capture=True)
    staged = deps / 'usb4-modules' / newrel
    staged.mkdir(parents=True, exist_ok=True)
    (staged / '70-strix-tbstream.rules').write_text(
        '# USB4 stream devices of the DeepSeek pair: read/write for the group that runs the engine\n'
        f'KERNEL=="tbstream*", MODE="0660", GROUP="{out(["id", "-gn"]) or "render"}"\n')
    src = out(['modinfo', '-F', 'srcversion', str(tree / 'drivers/thunderbolt/thunderbolt_stream.ko')])
    say('PASS', 'driver', f'kernel {newrel} built (thunderbolt_stream srcversion {src}; record it)')
    secure_boot_note()
    if deb:
        images = sorted(tree.parent.glob(f'linux-image-{newrel}_*.deb'))
        steps = [['dpkg', '-i', images[-1] if images else tree.parent / f'linux-image-{newrel}_VERSION.deb']]
    else:
        steps = [['make', '-C', tree, 'modules_install', 'install']]
    lab = driver / 'tools' / 'lab'
    steps += [['install', '-m', '0644', lab / 'usb4stream-dedicated.conf', '/etc/modprobe.d/usb4stream-dedicated.conf'],
              ['install', '-m', '0644', lab / 'usb4stream-lab.service', '/etc/systemd/system/usb4stream-lab.service']]
    steps += lab_file_steps(driver, staged) + settings + [['systemctl', 'daemon-reload'],
                                                          ['systemctl', 'enable', 'usb4stream-lab.service']]
    notes = notes + [f'boot the new kernel once without making it the default: sudo grub-reboot "<menu entry of {newrel}>", '
                     'then reboot; run ds41-pair driver-verify on both nodes; only then make it the default '
                     '(driver repository docs/NODE-SETUP.md, "Testing a new kernel")']
    root_steps(args, steps, notes, 'Keep the current kernel as the fallback entry. Never disable the IOMMU.')
    return 0


def lab_file_steps(driver, staged):
    lab = driver / 'tools' / 'lab'
    return [['install', '-m', '0644', staged / '70-strix-tbstream.rules', '/etc/udev/rules.d/70-strix-tbstream.rules'],
            ['install', '-m', '0755', lab / 'usb4stream_describe.py', '/usr/local/sbin/usb4stream-describe'],
            ['install', '-m', '0755', lab / 'setup-usb4stream-lab', '/usr/local/sbin/setup-usb4stream-lab'],
            ['udevadm', 'control', '--reload']]


def secure_boot_note():
    sb = glob.glob(str(sysp('/sys/firmware/efi/efivars')) + '/SecureBoot-*')
    if sb and Path(sb[0]).read_bytes()[-1:] == b'\x01':
        say('WARN', 'driver', 'Secure Boot is on: unsigned modules do not load. Sign them with a key enrolled in MOK '
            '(your distribution documents sign-file and mokutil) before installing.')


def cmd_driver_verify(args):
    cfg = load_config(args)
    release = platform.release()
    staged = Path(cfg['DEPS_DIR']) / 'usb4-modules' / release
    for mod in ('thunderbolt', 'thunderbolt_stream'):
        if not module_loaded(mod):
            say('FAIL', 'module', f'{mod} not loaded (ds41-pair driver prints the steps)')
            continue
        src = read(sysp(f'/sys/module/{mod}/srcversion'), '?')
        ko = staged / f'{mod}.ko'
        want = out(['modinfo', '-F', 'srcversion', str(ko)]) if ko.is_file() else None
        if want and want != src:
            say('WARN', 'module', f'{mod} loaded srcversion {src}, staged build {want}: the loaded module is another '
                'build (reload it, or ignore when you installed your own kernel)')
        else:
            say('PASS', 'module', f'{mod} loaded (srcversion {src})')
    if module_loaded('thunderbolt_stream'):
        say('PASS' if stream_module_current() else 'WARN', 'module', "stream module has the pinned series' newest "
            'stream attributes' if stream_module_current() else 'stream module predates the pinned driver series '
            '(ds41-pair driver builds the current one)')
    if module_loaded('thunderbolt_net'):
        say('WARN', 'module', 'thunderbolt_net loaded: one ring pair per controller is lost to the streams')
    links = usb4_links()
    for link in links:
        say(link_verdict(link)[0], "link", link_verdict(link)[1])
    say('PASS' if len(links) >= 2 else ('WARN' if links else 'FAIL'), 'cables',
        f'{len(links)} of 2 cables up' + ('' if links else ': connect the cables with both nodes on'))
    layout = read(sysp('/run/usb4stream-layout.json'))
    streams = []
    if layout:
        try:
            doc = json.loads(layout)
            streams = [(k, v) for k, v in doc.items() if '/' in k and isinstance(v, dict)]
        except ValueError:
            say('WARN', 'streams', '/run/usb4stream-layout.json is not valid JSON')
    else:
        say('FAIL', 'streams', 'no /run/usb4stream-layout.json: the usb4stream-pair service has not run')
    ok = 0
    for key, v in streams:
        dev = v.get('device', '?')
        dev_path = sysp(dev) if ROOT else Path(dev)
        attached = v.get('attached', True)
        rw = dev_path.exists() and os.access(dev_path, os.R_OK | os.W_OK)
        cable = v.get('cable')
        if rw and attached is not False:
            ok += 1
            say('PASS', 'streams', f'{key} {dev}' + (f' cable {cable}' if cable else '') + ' ready')
        else:
            say('WARN', 'streams', f'{key} {dev}: ' + ('not attached to a peer' if attached is False
                                                       else 'device missing or not read/write for you'))
    if streams:
        say('PASS' if ok >= 4 else 'WARN', 'streams', f'{ok} of 4 streams ready')
    if args.link_test:
        link_test(cfg)
    print('driver-verify: ' + ('FAIL (' + ', '.join(sorted(set(FAILS))) + ')' if FAILS else 'OK'))
    return 1 if FAILS else 0


def link_test(cfg):
    """Open the four streams from both nodes at once (the engine's own pairing) and exchange checked payloads."""
    bench = Path(cfg['BUILD_DIR']) / 'strix-dist-host-exchange-bench'
    if not bench.is_file():
        say('FAIL', 'link-test', f'{bench} missing: run ds41-pair build first')
        return
    if not cfg['PEER']:
        say('FAIL', 'link-test', 'needs PEER in the config (the other rank is started over SSH)')
        return
    peer_rank = '1' if cfg['RANK'] == '0' else '0'
    common = LINK_TEST_ARGS
    peer = subprocess.Popen(ssh_argv(cfg, peer_cli(cfg, f'_bench-rank {peer_rank}')), text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    mine = subprocess.run(['timeout', '120', str(bench), *common, '--rank', cfg['RANK']], text=True,
                          capture_output=True, stdin=subprocess.DEVNULL)
    try:
        peer_out, _ = peer.communicate(timeout=180)
    except subprocess.TimeoutExpired:
        peer.kill()
        peer_out, _ = peer.communicate()
    text = mine.stdout + mine.stderr
    topo = re.search(r'(\d+) stream\(s\) on (\d+) cable\(s\)', text + peer_out)
    rows = [l.strip() for l in text.splitlines() if 'median_us' in l]
    bad = [l for l in rows if not re.search(r'\bbad 0\b', l)]
    if mine.returncode == 0 and peer.returncode == 0 and rows and not bad:
        few = topo and int(topo[1]) < 4
        say('WARN' if few else 'PASS', 'link-test',
            (f'{topo[1]} streams on {topo[2]} cables paired; ' if topo else 'streams paired; ')
            + f'{len(rows)} checked exchanges, no bad payload'
            + ('; fewer than 4 streams: check both cables' if few else '') + '; '
            + '; '.join(re.sub(r'\s+(p10|p90|mean)\S*\s+\S+', '', l) for l in rows[:3])[:240])
    elif mine.returncode == 0 and peer.returncode == 0:
        say('FAIL', 'link-test', 'exchange finished with damaged payloads: ' + (bad[0] if bad else 'no result lines')[:200])
    else:
        say('FAIL', 'link-test', f'exchange failed (here {mine.returncode}, peer {peer.returncode}): '
            + (text.strip().splitlines() or ['?'])[-1][:200])


