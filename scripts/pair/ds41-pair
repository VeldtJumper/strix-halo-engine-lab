class _DropAuthOnRedirect(urllib.request.HTTPRedirectHandler):
    """The mirror redirects downloads to a storage host: the token stays with the mirror."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and urllib.parse.urlsplit(newurl).netloc != urllib.parse.urlsplit(req.full_url).netloc:
            new.remove_header('Authorization')
        return new


OPENER = urllib.request.build_opener(_DropAuthOnRedirect)


def http_get(url, dest=None, timeout=60):
    headers = {'User-Agent': 'ds41-pair'}
    token = os.environ.get('HF_TOKEN')
    if token:
        headers['Authorization'] = 'Bearer ' + token
    req = urllib.request.Request(url, headers=headers)
    with OPENER.open(req, timeout=timeout) as r:
        data = r.read()
    if dest:
        Path(dest).write_bytes(data)
    return data


def download(url, part, label):
    """Resumable download into PART (HTTP Range); re-run continues where it stopped."""
    print(f'download {label}', flush=True)
    for attempt in range(1, 11):
        have = part.stat().st_size if part.is_file() else 0
        headers = {'User-Agent': 'ds41-pair', 'Range': f'bytes={have}-'}
        if os.environ.get('HF_TOKEN'):
            headers['Authorization'] = 'Bearer ' + os.environ['HF_TOKEN']
        try:
            with OPENER.open(urllib.request.Request(url, headers=headers), timeout=60) as r:
                total = have + int(r.headers.get('Content-Length') or 0) if r.status == 206 else int(r.headers.get('Content-Length') or 0)
                with open(part, 'ab' if r.status == 206 else 'wb') as f:
                    done, last = (have if r.status == 206 else 0), time.time()
                    for block in iter(lambda: r.read(8 << 20), b''):
                        f.write(block)
                        done += len(block)
                        if time.time() - last > 30:
                            print(f'      {label}: {human(done)} of {human(total)}', flush=True)
                            last = time.time()
            if not total or done >= total:
                return
            print(f'      {label}: connection closed at {human(done)} of {human(total)}, retry {attempt}/10', flush=True)
            continue
        except urllib.error.HTTPError as exc:
            if exc.code == 416:
                return  # already complete
            if exc.code in (401, 403, 404):
                die(f'{label}: HTTP {exc.code} from the mirror (see docs/reproduce.md "Models and provenance")')
            print(f'      {label}: HTTP {exc.code}, retry {attempt}/10', flush=True)
        except (urllib.error.URLError, OSError, http.client.HTTPException) as exc:
            print(f'      {label}: {exc}, retry {attempt}/10', flush=True)
        time.sleep(min(60, 5 * attempt))
    die(f'download of {label} keeps failing; re-run ds41-pair fetch later to resume it')


def manifest(repo, rev, cache):
    """{name: sha256} of a mirror's SHA256SUMS at the pinned revision (cached on disk)."""
    path = cache / f'{repo}@{rev[:12]}.SHA256SUMS'
    if not path.is_file():
        cache.mkdir(parents=True, exist_ok=True)
        try:
            http_get(f'https://huggingface.co/{fetch_models.PREFIX}{repo}/resolve/{rev}/SHA256SUMS', path)
        except (urllib.error.URLError, OSError) as exc:
            die(f'cannot read SHA256SUMS of {repo} at {rev[:12]}: {exc}')
    entries = {}
    for line in path.read_text(encoding='utf-8').splitlines():
        m = re.fullmatch(r'([0-9a-f]{64})\s+\*?(.+)', line.strip())
        if not m:
            continue
        name = m[2]
        if name.startswith('/') or '..' in name.split('/') or '\\' in name:
            die(f'unsafe path in the {repo} manifest: {name}')
        entries[name] = m[1]
    return entries


def remote_sizes(repo, rev):
    """{name: bytes} from the hub tree listing (best effort; None offline)."""
    try:
        data = json.loads(http_get(f'https://huggingface.co/api/models/{fetch_models.PREFIX}{repo}/tree/{rev}?recursive=1'))
        return {e['path']: e.get('size') for e in data if e.get('type') == 'file'}
    except (urllib.error.URLError, OSError, ValueError):
        return None


def selected(entries, patterns):
    names = [n for n in entries if any(fnmatch.fnmatch(n, p) for p in patterns + ['LICENSE*', 'README*'])]
    for p in patterns:
        if not any(fnmatch.fnmatch(n, p) for n in entries):
            die(f'manifest has no file for {p}')
    return sorted(names)


class VerifyCache:
    """name -> (size, mtime_ns, sha256) of files already hashed, so re-runs do not re-read 390 GB."""

    def __init__(self, path):
        self.path = path
        try:
            self.data = json.loads(path.read_text())
        except (OSError, ValueError):
            self.data = {}

    def known(self, rel, path):
        st = path.stat()
        v = self.data.get(rel)
        return v[2] if v and v[0] == st.st_size and v[1] == st.st_mtime_ns else None

    def put(self, rel, path, digest):
        st = path.stat()
        self.data[rel] = [st.st_size, st.st_mtime_ns, digest]
        tmp = self.path.with_name(self.path.name + '.tmp')
        tmp.write_text(json.dumps(self.data, indent=0))
        os.replace(tmp, self.path)


def cmd_fetch(args):
    cfg = load_config(args)
    md = Path(cfg['MODEL_DIR'])
    cache = Path(cfg['DEPS_DIR']) / 'manifests'
    vc = VerifyCache(md / '.ds41-pair-verified.json') if not args.dry_run else None
    plan, missing_bytes, total_bytes = [], 0, 0
    for repo, rev, sub, patterns in jobs_for_pair():
        entries = manifest(repo, rev, cache)
        sizes = remote_sizes(repo, rev) if args.dry_run else None
        for name in selected(entries, patterns):
            if args.only and not any(fnmatch.fnmatch(name, g) for g in args.only):
                continue
            path = md / sub / name
            size = (sizes or {}).get(name)
            status = 'missing'
            if path.is_file():
                st = path.stat()
                status = 'present' if size is None or st.st_size == size else f'size {st.st_size} != {size}'
            elif path.with_name(path.name + '.part').is_file():
                status = f'partial {human(path.with_name(path.name + ".part").stat().st_size)}'
            plan.append((repo, rev, sub, name, entries[name], size, status))
            total_bytes += size or 0
            if status != 'present':
                missing_bytes += (size or 0) - (path.with_name(path.name + '.part').stat().st_size
                                                if status.startswith('partial') else 0)
    source = f'peer {cfg["PEER"]}:{cfg["PEER_MODEL_DIR"]}' if args.from_peer else 'the Hugging Face mirrors'
    if args.dry_run:
        print(f'fetch plan into {md} from {source}:')
        for repo, rev, sub, name, digest, size, status in plan:
            if status != 'present' or args.verbose:
                print(f'  {status:<22} {human(size) if size else "?":>10}  {repo}@{rev[:8]}  {name}')
        present = sum(1 for p in plan if p[6] == 'present')
        print(f'{present} of {len(plan)} files present (by name and size; fetch --verify hashes them), '
              f'{human(missing_bytes)} to transfer of {human(total_bytes)}; {human(free_bytes(md))} free')
        if missing_bytes > free_bytes(md):
            say('FAIL', 'disk', 'not enough free space for the remaining files')
        print('vocab/ is filled from aux/vocab/*.bin after the overlay is verified')
        return 1 if FAILS else 0
    md.mkdir(parents=True, exist_ok=True)
    if args.from_peer and not cfg['PEER']:
        die('--from-peer needs PEER in the config')
    bad = []
    for repo, rev, sub, name, digest, size, status in plan:
        path = md / sub / name
        rel = str(Path(sub) / name)
        if args.verify_only:
            if not path.is_file():
                print(f'missing  {name}')
                bad.append(name)
                continue
            known = None if args.verify else vc.known(rel, path)
            got = known or sha256(path, name)
            if got == digest:
                vc.put(rel, path, got)
                print(f'ok       {name}' + (' (cached)' if known else ''))
            else:
                print(f'MISMATCH {name}')
                bad.append(name)
            continue
        if path.is_file():
            known = None if args.verify else vc.known(rel, path)
            got = known or sha256(path, name)
            if got == digest:
                vc.put(rel, path, got)
                print(f'ok       {name}')
                continue
            print(f'MISMATCH {name}: removing it and fetching it again')
            path.unlink()
        part = path.with_name(path.name + '.part')
        path.parent.mkdir(parents=True, exist_ok=True)
        if args.from_peer:
            src = f'{cfg["PEER"]}:{Path(cfg["PEER_MODEL_DIR"]) / sub / name}'
            run(['rsync', '--protect-args', '--partial', '--append-verify', '--inplace', '-e', 'ssh -o BatchMode=yes',
                 src, part])
        else:
            download(f'https://huggingface.co/{fetch_models.PREFIX}{repo}/resolve/{rev}/{name}', part, name)
        got = sha256(part, name)
        if got != digest:
            part.unlink()
            die(f'SHA-256 mismatch for {name} (removed); re-run ds41-pair fetch to fetch it again')
        part.replace(path)
        vc.put(rel, path, got)
        print(f'fetched  {name}')
    if args.verify_only:
        if bad:
            say('FAIL', 'fetch', f'{len(bad)} of {len(plan)} files missing or not matching; ds41-pair fetch repairs them')
            return 1
        say('PASS', 'fetch', f'{len(plan)} files match their published SHA-256')
        return 0
    for repo, rev, sub, patterns in jobs_for_pair():
        shutil.copyfile(cache / f'{repo}@{rev[:12]}.SHA256SUMS', md / sub / f'SHA256SUMS.{repo}')
    vocab = md / 'vocab'
    vocab.mkdir(exist_ok=True)
    for f in sorted((md / 'aux' / 'vocab').glob('*.bin')):
        if not (vocab / f.name).is_file() or (vocab / f.name).read_bytes() != f.read_bytes():
            shutil.copyfile(f, vocab / f.name)
    print(f'PASS  fetch      every file matches its published SHA-256; layout ready in {md}')
    return 0


