def launcher():
    return HERE / 'ds41-pair-launch'


def pid_file():
    return state_dir() / 'rank.pid'


def log_file():
    return state_dir() / 'rank.log'


def running_pid():
    """The pid of the rank started by ds41-pair, if that process is still the engine (never a recycled pid)."""
    try:
        pid = int(pid_file().read_text().split()[0])
        cmdline = Path(f'/proc/{pid}/cmdline').read_bytes()
    except (OSError, ValueError, IndexError):
        return None
    if b'strix-deepseek41-serve' not in cmdline and b'ds41-pair-launch' not in cmdline:
        return None
    if Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[-1].split()[0] == 'Z':
        return None  # exited, not yet reaped
    return pid


def wait_event(log, offset, timeout, proc):
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            with open(log, 'rb') as f:
                f.seek(offset)
                text = f.read().decode('utf-8', 'replace')
        except OSError:
            text = ''
        if '"event":"READY"' in text:
            return 'READY', time.time() - t0
        m = re.search(r'"event":"POISONED"[^\n]*', text)
        if m:
            return m[0][:200], time.time() - t0
        if proc.poll() is not None:
            return f'exited ({proc.returncode})', time.time() - t0
        time.sleep(1)
    return 'timeout', time.time() - t0


def cmd_run(args):
    cfg = load_config(args)
    for name in (MODEL,):
        if not (Path(cfg['MODEL_DIR']) / name).is_file():
            die(f'{Path(cfg["MODEL_DIR"]) / name} missing: run ds41-pair fetch')
    if not (Path(cfg['BUILD_DIR']) / 'strix-deepseek41-serve').is_file():
        die('no engine build: run ds41-pair build')
    if args.foreground:
        os.execve(str(launcher()), [str(launcher())], dict(os.environ, STRIX_PAIR_CONFIG=cfg['_path']))
    if running_pid():
        print(f'rank {cfg["RANK"]} already running (pid {running_pid()}); ds41-pair stop first to restart')
        return 0
    if args.both:
        if not cfg['PEER']:
            die('--both needs PEER in the config')
        r = subprocess.run(ssh_argv(cfg, peer_cli(cfg, 'run --no-wait')), text=True)
        if r.returncode != 0:
            die('could not start the peer rank')
    state_dir().mkdir(parents=True, exist_ok=True)
    log = log_file()
    offset = log.stat().st_size if log.is_file() else 0
    with open(log, 'ab') as f:
        f.write(f'\n=== ds41-pair run {datetime.datetime.now().isoformat(timespec="seconds")}\n'.encode())
        offset = f.tell()
        p = subprocess.Popen([str(launcher())], stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True, env=dict(os.environ, STRIX_PAIR_CONFIG=cfg['_path']))
    pid_file().write_text(f'{p.pid}\n')
    print(f'rank {cfg["RANK"]} started (pid {p.pid}), log {log}')
    if args.no_wait:
        return 0
    print('waiting for READY (model load and warm-up take one to a few minutes; the other rank must be started too)')
    event, secs = wait_event(log, offset, args.wait, p)
    if event == 'READY':
        where = f'http://{cfg["HTTP_BIND"]}:{cfg["HTTP_PORT"]}' if cfg['RANK'] == '0' else 'rank 1 (no HTTP)'
        print(f'PASS  run        rank {cfg["RANK"]} READY after {secs:.0f} s: {where}')
        if cfg['RANK'] == '0':
            print('Next: ds41-pair smoke')
        return 0
    print(f'FAIL  run        rank {cfg["RANK"]}: {event} after {secs:.0f} s; last log lines:')
    for line in (read(log, '') or '').splitlines()[-8:]:
        print('    ' + line[:240])
    return 1


def cmd_stop(args):
    cfg = load_config(args)
    pid = running_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)  # clean stop: finish running requests; rank 0 also stops rank 1
        for _ in range(90):
            if not running_pid():
                break
            time.sleep(1)
        print(f'rank {cfg["RANK"]} ' + ('stopped' if not running_pid() else f'still running (pid {pid})'))
    else:
        print(f'rank {cfg["RANK"]} not running (started by ds41-pair)')
    if args.both and cfg['PEER']:
        subprocess.run(ssh_argv(cfg, peer_cli(cfg, 'stop')))
    return 0


def cmd_status(args):
    cfg = load_config(args)
    pid = running_pid()
    log = log_file()
    text = read(log, '') or ''
    last_run = text.rsplit('=== ds41-pair run', 1)[-1]
    state = 'READY' if '"event":"READY"' in last_run else ('POISONED' if 'POISONED' in last_run else 'starting')
    print(f'rank {cfg["RANK"]}: ' + (f'running pid {pid}, {state}' if pid else 'not running') + f'; log {log}')
    if pid and cfg['RANK'] == '0':
        try:
            with urllib.request.urlopen(f'http://{http_host(cfg)}:{cfg["HTTP_PORT"]}/health', timeout=5) as r:
                print(f'HTTP /health {r.status}')
        except (urllib.error.URLError, OSError) as exc:
            print(f'HTTP /health not answering ({exc})')
    return 0


def cmd_logs(args):
    lines = (read(log_file(), '') or '').splitlines()
    print('\n'.join(lines[-args.lines:]))
    return 0


def unit_quote(path):
    """A path inside a double-quoted systemd value: % is a specifier, quotes and backslashes are escaped."""
    return str(path).replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%')


def cmd_unit(args):
    cfg = load_config(args)
    unit_dir = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'systemd' / 'user'
    unit = unit_dir / 'strix-ds41-pair.service'
    text = ('[Unit]\nDescription=DeepSeek V4.1 Flash pair, rank %s\nAfter=network-online.target\n\n'
            '[Service]\nType=simple\nEnvironment="STRIX_PAIR_CONFIG=%s"\nExecStart="%s"\n'
            'Restart=on-failure\nRestartSec=30\nKillSignal=SIGTERM\nTimeoutStopSec=90\n\n'
            '[Install]\nWantedBy=default.target\n') % (cfg['RANK'], unit_quote(Path(cfg['_path']).absolute()),
                                                         unit_quote(launcher()))
    unit_dir.mkdir(parents=True, exist_ok=True)
    unit.write_text(text)
    print(f'wrote {unit}')
    steps = [['systemctl', '--user', 'daemon-reload'], ['systemctl', '--user', 'enable', '--now', unit.name]]
    if args.install:
        for s in steps:
            run(s)
    else:
        for s in steps:
            print('  ' + shlex.join(s))
    print(f'To start it at boot without logging in, once as root: sudo loginctl enable-linger {out(["id", "-un"]) or "$USER"}')
    print('Logs: journalctl --user -u strix-ds41-pair -f. Use the unit or ds41-pair run, not both.')
    return 0


# --------------------------------------------------------------------------------------------------------------- smoke
def http_host(cfg):
    host = '127.0.0.1' if cfg['HTTP_BIND'] in ('0.0.0.0', '::', '') else cfg['HTTP_BIND']
    return f'[{host}]' if ':' in host else host


def completion(base, key, prompt, max_tokens):
    body = {'model': 'deepseek-v4.1-flash', 'prompt': prompt, 'max_tokens': max_tokens, 'temperature': 0,
            'stream': True, 'return_token_ids': True}
    headers = {'Content-Type': 'application/json'}
    if key:
        headers['Authorization'] = 'Bearer ' + key
    req = urllib.request.Request(base + '/v1/completions', data=json.dumps(body).encode(), headers=headers)
    t0 = time.perf_counter()
    first = last = None
    ids, chunks = [], 0
    with urllib.request.urlopen(req, timeout=600) as r:
        for raw in r:
            line = raw.decode('utf-8', 'replace').strip()
            if not line.startswith('data:'):
                continue
            data = line[5:].strip()
            if data == '[DONE]':
                break
            j = json.loads(data)
            ids += (j.get('strix') or {}).get('token_ids') or []
            ch = (j.get('choices') or [{}])[0]
            if ch.get('text'):
                now = time.perf_counter() - t0
                first = now if first is None else first
                last = now
                chunks += 1
    return ids, first, last


def cmd_smoke(args):
    cfg = load_config(args)
    if cfg['RANK'] != '0' and not args.port:
        if not cfg['PEER']:
            die('smoke talks to rank 0; run it there (or set PEER)')
        return subprocess.run(ssh_argv(cfg, peer_cli(cfg, 'smoke'))).returncode
    ref = json.loads(Path(args.reference or SMOKE_REFERENCE).read_text(encoding='utf-8'))
    base = f'http://{args.host or http_host(cfg)}:{args.port or cfg["HTTP_PORT"]}'
    key = Path(cfg['API_KEY_FILE']).read_text().strip() if cfg['API_KEY_FILE'] else None
    t0 = time.time()
    while True:
        try:
            with urllib.request.urlopen(base + '/health', timeout=5) as r:
                if r.status == 200:
                    break
        except (urllib.error.URLError, OSError):
            pass
        if time.time() - t0 > args.wait:
            die(f'no answer from {base}/health after {args.wait} s: is rank 0 READY? (ds41-pair status)')
        time.sleep(2)
    def ask(prompt, tokens):
        try:
            return completion(base, key, prompt, tokens)
        except urllib.error.HTTPError as exc:
            die(f'{base}/v1/completions answered HTTP {exc.code}' + (' (check API_KEY_FILE)' if exc.code == 401 else ''))
        except (urllib.error.URLError, OSError, http.client.HTTPException) as exc:
            say('FAIL', 'smoke', f'the server stopped answering ({exc}); ds41-pair logs shows why (both ranks)')
            sys.exit(1)

    ids, _, _ = ask(ref['prompt'], ref['max_tokens'])
    digest = hashlib.sha256(json.dumps(ids).encode()).hexdigest()[:16]
    if not ids:
        say('FAIL', 'smoke', 'the server returned no tokens; ds41-pair logs shows why (both ranks)')
        return 1
    if args.record:
        doc = dict(ref, token_ids=ids, token_ids_sha256_16=digest)
        Path(args.record).write_text(json.dumps(doc, indent=1) + '\n', encoding='utf-8')
        print(f'recorded {len(ids)} ids (digest {digest}) to {args.record}')
    profile = cfg['PROFILE']
    if not ref.get('token_ids'):
        say('INFO', 'smoke', f'no published reference in this checkout; ids digest {digest} ({len(ids)} ids)')
    elif profile not in ref.get('profiles', ['default']):
        say('INFO', 'smoke', f'profile {profile} has no published reference; ids digest {digest} ({len(ids)} ids)')
    elif ids == ref['token_ids']:
        say('PASS', 'smoke', f'{len(ids)} token ids equal the published reference (digest {digest})')
    else:
        n = next((i for i, (a, b) in enumerate(zip(ids, ref['token_ids'])) if a != b), min(len(ids), len(ref['token_ids'])))
        say('FAIL', 'smoke', f'token ids differ from the reference at position {n} (digest {digest}, reference '
            f'{ref["token_ids_sha256_16"]}): check that both nodes run the same build, profile and verified files')
    ids, first, last = ask(ref['speed_prompt'], ref['speed_tokens'])
    if first is not None and last and last > first and len(ids) > 1:
        print(f'speed: TTFT {first:.2f} s, {len(ids)} tokens, decode {(len(ids) - 1) / (last - first):.1f} tok/s '
              '(one stream, DSpark on; varies with the text)')
    return 1 if FAILS else 0


# ---------------------------------------------------------------------------------------------------------------- main
def main(argv=None):
    p = argparse.ArgumentParser(prog='ds41-pair', description=__doc__.split('\n\n')[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split('\n\n', 1)[1])
    p.add_argument('--config', help='config file (default: $STRIX_PAIR_CONFIG or ~/.config/strix-pair/ds41.conf)')
    sub = p.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('init', help='write or update this node\'s config')
    s.add_argument('--rank', choices=['0', '1'])
    s.add_argument('--peer', help='SSH destination of the other node, e.g. user@node-b')
    s.add_argument('--model-dir')
    s.add_argument('--profile', choices=PROFILES)
    s.add_argument('--build-dir')
    s.add_argument('--http-bind')
    s.add_argument('--http-port')
    s.add_argument('--api-key-file')
    s.add_argument('--context')
    s.add_argument('--peer-repo')
    s.add_argument('--peer-model-dir')
    s.add_argument('--peer-config')
    s.add_argument('--rocm')
    s.add_argument('--deps-dir')
    s.add_argument('--force', action='store_true')
    sub.add_parser('config', help='print the effective config')
    s = sub.add_parser('check', help='read-only preflight')
    s.add_argument('--no-peer', action='store_true')
    s = sub.add_parser('driver', help='build the USB4 driver modules for the running kernel; print the root steps')
    s.add_argument('--yes-root', action='store_true', help='run the root steps with sudo, each shown first')
    s.add_argument('--rebuild', action='store_true')
    s.add_argument('--full', action='store_true', help='build the whole kernel tree (no linux-headers Module.symvers)')
    s.add_argument('--dry-run', action='store_true', help='sources, series and version check, plan and root steps; no compile')
    s.add_argument('--kernel', action='store_true', help='build the whole patched kernel (another kernel version, or USB4 built in)')
    s.add_argument('--localversion', help='LOCALVERSION of the new kernel (--kernel; must start with -strix-gpu-bosgame-)')
    s.add_argument('--jobs', type=int)
    s = sub.add_parser('driver-verify', help='modules, cables, link speed, four streams')
    s.add_argument('--link-test', action='store_true', help='also pair the streams with the peer and exchange data')
    s = sub.add_parser('build', help='build the trellis library and the engine')
    s.add_argument('--jobs', type=int)
    s.add_argument('--clean', action='store_true')
    s = sub.add_parser('fetch', help='download / copy and verify the production files')
    s.add_argument('--dry-run', action='store_true')
    s.add_argument('--from-peer', action='store_true', help='copy from the peer\'s model directory (rsync over SSH)')
    s.add_argument('--verify', action='store_true', help='re-hash every file even when its size and time are unchanged')
    s.add_argument('--verify-only', action='store_true', help='hash the files already present; transfer nothing')
    s.add_argument('--only', action='append', metavar='GLOB', help='limit to matching files (repeatable)')
    s.add_argument('--verbose', '-v', action='store_true')
    s = sub.add_parser('prepare', help='optional one-time expert preparation')
    s.add_argument('--dry-run', action='store_true')
    s.add_argument('--force', action='store_true')
    s = sub.add_parser('run', help='start this node\'s rank')
    s.add_argument('--both', action='store_true', help='also start the peer\'s rank over SSH')
    s.add_argument('--foreground', action='store_true')
    s.add_argument('--no-wait', action='store_true')
    s.add_argument('--wait', type=int, default=420)
    s = sub.add_parser('stop', help='stop this node\'s rank')
    s.add_argument('--both', action='store_true')
    sub.add_parser('status', help='is the rank running and READY')
    s = sub.add_parser('logs', help='last lines of the rank log')
    s.add_argument('-n', '--lines', type=int, default=40)
    s = sub.add_parser('unit', help='write a systemd user unit for this rank')
    s.add_argument('--install', action='store_true', help='also enable and start it (systemctl --user)')
    s = sub.add_parser('smoke', help='exact token check and one speed line')
    s.add_argument('--host')
    s.add_argument('--port')
    s.add_argument('--wait', type=int, default=60)
    s.add_argument('--record', help=argparse.SUPPRESS)
    s.add_argument('--reference', help=argparse.SUPPRESS)
    s = sub.add_parser('_bench-rank')
    s.add_argument('rank', choices=['0', '1'])
    sub.add_parser('_serve-sha')
    a = p.parse_args(argv)
    handler = {'init': cmd_init, 'config': cmd_config, 'check': cmd_check, 'driver': cmd_driver,
               'driver-verify': cmd_driver_verify, 'build': cmd_build, 'fetch': cmd_fetch, 'prepare': cmd_prepare,
               'run': cmd_run, 'stop': cmd_stop, 'status': cmd_status, 'logs': cmd_logs, 'unit': cmd_unit,
               'smoke': cmd_smoke, '_bench-rank': cmd_bench_rank, '_serve-sha': cmd_serve_sha}[a.cmd]
    return handler(a) or 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:  # output piped into head or similar
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
