def load_config(args, required=True):
    path = config_path(args)
    cfg = dict(DEFAULTS)
    if path.is_file():
        for n, line in enumerate(path.read_text(encoding='utf-8').splitlines(), 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            key, sep, value = line.partition('=')
            if not sep or not re.fullmatch(r'[A-Z_]+', key):
                die(f'{path}:{n}: expected KEY=VALUE')
            parts = shlex.split(value, comments=True)
            cfg[key] = ' '.join(parts)
            if key not in ('EXTRA_ARGS',):
                cfg[key] = os.path.expanduser(os.path.expandvars(cfg[key]))
    elif required:
        die(f'no config at {path}; run: ds41-pair init --rank 0|1 --peer USER@OTHER-NODE --model-dir DIR')
    cfg['BUILD_DIR'] = cfg['BUILD_DIR'] or str(REPO / 'build-ds41')
    cfg['DEPS_DIR'] = cfg['DEPS_DIR'] or str(data_dir())
    cfg['PEER_REPO'] = cfg['PEER_REPO'] or str(REPO)
    cfg['PEER_MODEL_DIR'] = cfg['PEER_MODEL_DIR'] or cfg['MODEL_DIR']
    cfg['_path'] = str(path)
    if required:
        if cfg['RANK'] not in ('0', '1'):
            die(f'{path}: RANK must be 0 or 1')
        if not cfg['MODEL_DIR']:
            die(f'{path}: MODEL_DIR is empty')
        if cfg['PROFILE'] not in PROFILES:
            die(f'{path}: PROFILE must be one of {", ".join(PROFILES)}')
    return cfg


def write_config(path, cfg):
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = ['# ds41-pair config of this node (shell syntax; read by ds41-pair and ds41-pair-launch).',
             '# The other node has its own file with the other RANK; everything else should match.']
    for key in DEFAULTS:
        lines.append(f'# {CONFIG_DOC[key]}')
        lines.append(f'{key}={shlex.quote(cfg.get(key, ""))}')
    tmp = path.with_name(path.name + '.tmp')
    tmp.write_text('\n'.join(lines) + '\n', encoding='utf-8')
    os.replace(tmp, path)


def raw_config(path):
    """The keys as written in the file, without the derived defaults."""
    cfg = dict(DEFAULTS)
    for line in path.read_text(encoding='utf-8').splitlines():
        key, sep, value = line.strip().partition('=')
        if sep and re.fullmatch(r'[A-Z_]+', key) and not line.strip().startswith('#'):
            cfg[key] = ' '.join(shlex.split(value, comments=True))
    return cfg


def cmd_init(args):
    path = config_path(args)
    cfg = raw_config(path) if path.is_file() else dict(DEFAULTS)
    if path.is_file() and not args.force:
        print(f'updating {path} (only the options you gave change)')
    for key, value in (('RANK', args.rank), ('PEER', args.peer), ('MODEL_DIR', args.model_dir),
                       ('PROFILE', args.profile), ('BUILD_DIR', args.build_dir), ('HTTP_PORT', args.http_port),
                       ('HTTP_BIND', args.http_bind), ('PEER_REPO', args.peer_repo),
                       ('PEER_MODEL_DIR', args.peer_model_dir), ('PEER_CONFIG', args.peer_config),
                       ('API_KEY_FILE', args.api_key_file),
                       ('CONTEXT', args.context), ('ROCM_PATH', args.rocm), ('DEPS_DIR', args.deps_dir)):
        if value is not None:
            cfg[key] = (str(Path(value).expanduser().absolute()) if key in ('MODEL_DIR', 'BUILD_DIR', 'DEPS_DIR')
                        else str(value))
    if cfg.get('RANK') not in ('0', '1'):
        die('--rank 0 or --rank 1 is required')
    if not cfg.get('MODEL_DIR'):
        die('--model-dir is required')
    if cfg.get('PROFILE', 'default') not in PROFILES:
        die('--profile must be one of ' + ', '.join(PROFILES))
    for key in ('_path',):
        cfg.pop(key, None)
    # Keep derived defaults implicit so that the file stays portable between the two nodes.
    for key in ('BUILD_DIR', 'DEPS_DIR', 'PEER_REPO', 'PEER_MODEL_DIR'):
        if cfg.get(key) in (str(REPO / 'build-ds41'), str(data_dir()), str(REPO)):
            cfg[key] = ''
    if cfg.get('PEER_MODEL_DIR') == cfg.get('MODEL_DIR'):
        cfg['PEER_MODEL_DIR'] = ''
    write_config(path, cfg)
    print(f'wrote {path}: rank {cfg["RANK"]}, peer {cfg.get("PEER") or "(none)"}, model dir {cfg["MODEL_DIR"]}, '
          f'profile {cfg.get("PROFILE") or "default"}')
    other = '1' if cfg['RANK'] == '0' else '0'
    print(f'On the other node run the same with --rank {other} (and --peer pointing back here).')
    print('Next: ds41-pair check')


