def sysp(path):
    return Path(ROOT + path) if ROOT else Path(path)


def say(level, topic, text):
    tag = {'PASS': '\033[32mPASS\033[0m', 'WARN': '\033[33mWARN\033[0m', 'FAIL': '\033[31mFAIL\033[0m',
           'INFO': 'INFO'}[level] if COLOR else level
    print(f'{tag}  {topic:<10} {text}', flush=True)
    if level == 'FAIL':
        FAILS.append(topic)


def die(text, code=1):
    print('ds41-pair: ' + text, file=sys.stderr)
    sys.exit(code)


def read(path, default=None):
    try:
        return Path(path).read_text(encoding='utf-8', errors='replace').strip()
    except OSError:
        return default


def run(argv, check=True, cwd=None, env=None, capture=False, show=True):
    if show:
        print('+ ' + shlex.join(map(str, argv)), flush=True)
    r = subprocess.run(list(map(str, argv)), cwd=cwd, env=env, text=True,
                       stdout=subprocess.PIPE if capture else None, stderr=subprocess.STDOUT if capture else None)
    if check and r.returncode != 0:
        if capture and r.stdout:
            print(r.stdout[-4000:], end='')
        die(f'command failed ({r.returncode}): {shlex.join(map(str, argv))}')
    return r


def out(argv, timeout=30):
    try:
        r = subprocess.run(argv, text=True, capture_output=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def human(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if abs(n) < 1000 or unit == 'TB':
            return f'{n:.1f} {unit}' if unit != 'B' else f'{n} B'
        n /= 1000.0
    return str(n)


def sha256(path, label=None):
    h = hashlib.sha256()
    size = path.stat().st_size
    done, last = 0, time.time()
    with path.open('rb') as f:
        for block in iter(lambda: f.read(16 << 20), b''):
            h.update(block)
            done += len(block)
            if size > (4 << 30) and time.time() - last > 15:
                print(f'      hashing {label or path.name}: {100 * done // size} %', flush=True)
                last = time.time()
    return h.hexdigest()


