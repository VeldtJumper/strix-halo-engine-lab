def model_files_status(cfg):
    md = Path(cfg['MODEL_DIR'])
    need, present = 0, []
    for name, size in SIZES.items():
        p = md / name.rstrip('/')
        if name.endswith('/'):
            have = sum(f.stat().st_size for f in p.rglob('*') if f.is_file()) if p.is_dir() else 0
        else:
            have = p.stat().st_size if p.is_file() else 0
        if have >= size:
            present.append(name.rstrip('/'))
        need += max(0, size - have)
    return need, present


def free_bytes(path):
    p = Path(path)
    while not p.exists() and p != p.parent:
        p = p.parent
    return shutil.disk_usage(p).free


def cmd_check(args):
    cfg = load_config(args)
    print(f'ds41-pair check: rank {cfg["RANK"]}, config {cfg["_path"]}')
    # Hardware
    cpu = re.search(r'^model name\s*:\s*(.+)$', read(sysp('/proc/cpuinfo'), '') or '', re.M)
    cpu = cpu[1].strip() if cpu else '?'
    say('PASS' if re.search(r'Ryzen AI MAX', cpu, re.I) else 'WARN', 'cpu',
        cpu + ('' if re.search(r'Ryzen AI MAX', cpu, re.I) else ' (not a Strix Halo Ryzen AI Max: untested)'))
    gpus = gpu_targets()
    if 'gfx1151' in gpus:
        say('PASS', 'gpu', 'gfx1151 (Radeon 8060S) visible through /dev/kfd')
    else:
        say('FAIL', 'gpu', f'no gfx1151 GPU in the KFD topology ({", ".join(gpus) or "none"}): install amdgpu/ROCm')
    kfd = sysp('/dev/kfd')
    if kfd.exists():
        say('PASS' if os.access(kfd, os.R_OK | os.W_OK) else 'FAIL', 'kfd',
            '/dev/kfd read/write' if os.access(kfd, os.R_OK | os.W_OK)
            else '/dev/kfd not writable: add your user to the render and video groups, log in again')
    mem = meminfo()
    total = mem.get('MemTotal', 0)
    vram = sum(int(read(p, '0') or 0) for p in glob.glob(str(sysp('/sys/class/drm')) + '/card*/device/mem_info_vram_total'))
    if total + vram >= 120 << 30:
        say('PASS', 'memory', f'{total / 2**30:.0f} GiB system + {vram / 2**30:.1f} GiB GPU carve-out (128 GB class)')
    else:
        say('FAIL', 'memory', f'{(total + vram) / 2**30:.0f} GiB in total; the pair needs a 128 GB node')
    if vram > 8 << 30:
        say('WARN', 'memory', f'{vram / 2**30:.0f} GiB reserved as VRAM in firmware; the engine allocates from system '
            'memory (GTT): a small UMA carve-out leaves more for the model')
    gtt = sum(int(read(p, '0') or 0) for p in glob.glob(str(sysp('/sys/class/drm')) + '/card*/device/mem_info_gtt_total'))
    if gtt >= 100 << 30:
        say('PASS', 'memory', f'GPU can map {gtt / 2**30:.0f} GiB of system memory (GTT)')
    elif gtt:
        say('FAIL', 'memory', f'GTT limit {gtt / 2**30:.0f} GiB: the pair needs about 117 GiB '
            f'(options ttm pages_limit={TTM_PAGES_LIMIT}; ds41-pair driver prints the step)')
    if 'kho=off' not in (read(sysp('/proc/cmdline'), '') or '').split():
        say('WARN', 'memory', 'kho=off missing from the kernel command line: Kexec HandOver keeps a scratch area '
            'reserved (ds41-pair driver prints the step)')
    kfd_procs = glob.glob(str(sysp('/sys/class/kfd/kfd/proc')) + '/*')
    if kfd_procs:
        say('WARN', 'gpu', f'{len(kfd_procs)} process(es) hold the GPU now; stop them before run')
    # Kernel, IOMMU, USB4
    release = platform.release()
    say('INFO', 'kernel', release + (' (the driver series targets Linux 7.3-rc5)' if not release.startswith('7.3') else ''))
    cmdline = read(sysp('/proc/cmdline'), '') or ''
    if re.search(r'(^|\s)(amd_iommu=off|iommu=off)(\s|$)', cmdline):
        say('FAIL', 'iommu', 'disabled on the kernel command line: the USB4 driver needs the IOMMU; remove that option')
    elif re.search(r'(^|\s)iommu=pt(\s|$)', cmdline):
        say('WARN', 'iommu', 'iommu=pt puts every device in passthrough: keep the USB4 controllers translated '
            '(per-group passthrough only, see the driver README)')
    elif list(glob.glob(str(sysp('/sys/class/iommu')) + '/*')):
        say('PASS', 'iommu', 'on')
    else:
        say('WARN', 'iommu', 'no IOMMU found: enable it in the firmware (never disable it for speed)')
    for nhi in nhi_devices():
        if nhi['type'] in ('DMA', 'DMA-FQ'):
            say('PASS', 'iommu', f'USB4 controller {nhi["pci"]} translated ({nhi["type"]})')
        elif nhi['type']:
            say('WARN', 'iommu', f'USB4 controller {nhi["pci"]} in {nhi["type"]} mode: keep it translated (DMA-FQ)')
    for dom in sorted(glob.glob(str(sysp('/sys/bus/thunderbolt/devices')) + '/domain*')):
        prot = read(dom + '/iommu_dma_protection')
        if prot is not None:
            say('PASS' if prot == '1' else 'WARN', 'iommu', f'{os.path.basename(dom)} DMA protection '
                + ('on' if prot == '1' else 'off: keep the USB4 controllers behind the IOMMU'))
    perfopt = read(sysp('/sys/module/amdgpu/parameters/iommu_perfopt'))
    if perfopt is not None:
        say('INFO', 'iommu', f'amdgpu.iommu_perfopt={perfopt} (record it with any timing)')
    if module_loaded('thunderbolt_stream'):
        say('PASS', 'usb4', 'thunderbolt_stream loaded (srcversion '
            f'{read(sysp("/sys/module/thunderbolt_stream/srcversion"), "?")})')
    else:
        say('FAIL', 'usb4', 'thunderbolt_stream is not loaded: run ds41-pair driver')
    if module_loaded('thunderbolt_net'):
        say('WARN', 'usb4', 'thunderbolt_net is loaded: it takes one ring pair per controller; unload/blacklist it')
    links = usb4_links()
    for link in links:
        say(link_verdict(link)[0], "link", link_verdict(link)[1])
    if not links:
        say('FAIL', 'usb4', 'no USB4 link up: connect the two cables between the nodes with both nodes on')
    elif len(links) == 1:
        say('WARN', 'usb4', 'one cable up: the pair runs, with about half the link bandwidth; two cables are expected')
    else:
        say('PASS', 'usb4', f'{len(links)} cables up')
    devs = stream_devices()
    usable = [d for d in devs if os.access(d, os.R_OK | os.W_OK)]
    if len(usable) >= 4:
        say('PASS', 'streams', f'{len(usable)} stream devices read/write')
    elif devs:
        say('WARN', 'streams', f'{len(devs)} stream devices, {len(usable)} read/write for you: install the udev rule '
            'printed by ds41-pair driver')
    else:
        say('WARN' if module_loaded('thunderbolt_stream') else 'INFO', 'streams',
            'no /dev/tbstream*: the stream service is not set up (ds41-pair driver prints the steps)')
    if not sysp('/run/usb4stream-layout.json').is_file() and module_loaded('thunderbolt_stream'):
        say('WARN', 'streams', '/run/usb4stream-layout.json missing: the usb4stream service has not run')
    # Storage
    need, present = model_files_status(cfg)
    free = free_bytes(cfg['MODEL_DIR'])
    if need == 0:
        say('PASS', 'models', f'all production files present in {cfg["MODEL_DIR"]} (sizes; fetch --verify hashes them)')
    elif free > need + (5 << 30):
        say('PASS', 'disk', f'{human(free)} free for {human(need)} still to fetch')
    else:
        say('FAIL', 'disk', f'{human(free)} free at {cfg["MODEL_DIR"]}, {human(need)} still to fetch')
    prep_root = prepared_root()
    if free_bytes(prep_root) < PREPARED_BYTES and not list(Path(prep_root).glob(f'rank{cfg["RANK"]}-tp-dup-*')):
        say('INFO', 'disk', f'prepare (optional) needs about {human(PREPARED_BYTES)} free in {prep_root}')
    # Toolchain
    rocm = rocm_root(cfg)
    hipc = hip_compiler(rocm)
    say('PASS' if hipc else 'FAIL', 'rocm', f'{rocm} (HIP compiler {hipc})' if hipc
        else f'no HIP compiler under {rocm}: install ROCm or set ROCM_PATH in the config')
    cm = out(['cmake', '--version'])
    cmv = version_tuple(cm.splitlines()[0]) if cm else ()
    say('PASS' if cmv >= (3, 24) else 'FAIL', 'tools', f'cmake {".".join(map(str, cmv))}' if cm else 'cmake missing (>= 3.24)')
    for tool in ('ninja', 'git', 'make', 'gcc', 'flex', 'bison'):
        if not shutil.which(tool):
            say('FAIL' if tool in ('ninja', 'git') else 'WARN', 'tools',
                f'{tool} missing' + (' (driver build)' if tool in ('make', 'gcc', 'flex', 'bison') else ''))
    if sys.version_info < (3, 10):
        say('FAIL', 'tools', f'python {platform.python_version()} (>= 3.10 needed)')
    if not sysp('/usr/include/openssl/sha.h').is_file():
        say('WARN', 'tools', 'OpenSSL headers missing (libssl-dev): hashing falls back to the slower portable SHA-256')
    if not shutil.which('rsync'):
        say('INFO', 'tools', 'rsync missing: fetch --from-peer needs it')
    # Build
    serve = Path(cfg['BUILD_DIR']) / 'strix-deepseek41-serve'
    local_sha = sha256(serve)[:16] if serve.is_file() else None
    say('PASS' if local_sha else 'INFO', 'build', f'{serve} sha256 {local_sha}' if local_sha else 'not built yet (ds41-pair build)')
    # Peer
    if args.no_peer or not cfg['PEER']:
        say('INFO', 'peer', 'skipped' if args.no_peer else 'no PEER in the config')
    else:
        probe = 'hostname; ' + peer_cli(cfg, 'config') + ' 2>/dev/null | grep -E "^RANK="; ' + peer_cli(cfg, '_serve-sha')
        r = subprocess.run(ssh_argv(cfg, probe), text=True, capture_output=True, timeout=60)
        if r.returncode not in (0, 1) or not r.stdout:
            say('FAIL', 'peer', f'{cfg["PEER"]} not reachable over SSH (BatchMode): set up a key, check the address')
        else:
            lines = r.stdout.splitlines()
            say('PASS', 'peer', f'{cfg["PEER"]} reachable (host {lines[0]})')
            rank = next((l.split('=', 1)[1].strip("'") for l in lines if l.startswith('RANK=')), None)
            if rank is None:
                say('WARN', 'peer', 'no ds41-pair config on the peer yet (run init there)')
            elif rank == cfg['RANK']:
                say('FAIL', 'peer', f'the peer is also rank {rank}: one node is 0, the other 1')
            else:
                say('PASS', 'peer', f'peer is rank {rank}')
            peer_sha = next((l.split()[1] for l in lines if l.startswith('serve-sha ')), None)
            if local_sha and peer_sha:
                say('PASS' if peer_sha == local_sha else 'WARN', 'peer',
                    'same engine binary on both nodes' if peer_sha == local_sha
                    else f'engine binaries differ ({local_sha} here, {peer_sha} there): build the same commit on both')
            if links and lines[0] not in {l['peer'] for l in links}:
                say('WARN', 'peer', f'the USB4 links go to {", ".join(sorted({l["peer"] for l in links}))}, '
                    f'not to {lines[0]}')
    print('check: ' + ('FAIL (' + ', '.join(sorted(set(FAILS))) + ')' if FAILS else 'OK'))
    return 1 if FAILS else 0


