namespace strix::h3::te {
namespace {

using Half16 = _Float16 __attribute__((ext_vector_type(16)));
using Float8 = float __attribute__((ext_vector_type(8)));
using Vec4 = unsigned __attribute__((ext_vector_type(4)));

constexpr unsigned kHidden = 5120, kFfn = 25600, kHeads = 64, kKvHeads = 8, kHeadDim = 128;
constexpr unsigned kQkv = (kHeads + 2 * kKvHeads) * kHeadDim;  // 10240
constexpr unsigned kAttn = kHeads * kHeadDim;                   // 8192
constexpr float kEps = 1e-6F;

// Reference RoPE inverse frequencies (FP32 bits, see the generator).
// generated by tools/h3/te/gen_te_rope.py (torch 2.10.0+cpu)
constexpr std::uint32_t kInvFreqBits[64] = {
    0x3F800000U, 0x3F492C28U, 0x3F1E165DU, 0x3EF875A7U, 0x3EC33F3AU, 0x3E996E52U, 0x3E712429U, 0x3E3D7EFCU,
    0x3E14E963U, 0x3DEA09DBU, 0x3DB7EA1AU, 0x3D908687U, 0x3D63251BU, 0x3D327F50U, 0x3D0C44BFU, 0x3CDC7456U,
    0x3CAD3D5EU, 0x3C88230FU, 0x3C55F605U, 0x3C282311U, 0x3C042088U, 0x3BCFA8A9U, 0x3BA32F3EU, 0x3B803C3DU,
    0x3B498AD3U, 0x3B1E60C3U, 0x3AF8EA93U, 0x3AC39B1CU, 0x3A99B686U, 0x3A7195A5U, 0x3A3DD829U, 0x3A152F76U,
    0x39EA77FFU, 0x39B840A8U, 0x3990CA8BU, 0x39639000U, 0x3932D34FU, 0x390C86C1U, 0x38DCDC14U, 0x38AD8EE4U,
    0x38886320U, 0x38565AB5U, 0x38287230U, 0x38045EB6U, 0x37D00A62U, 0x37A37C09U, 0x37807896U, 0x3749E9ABU,
    0x371EAB4BU, 0x36F95FB6U, 0x36C3F72AU, 0x3699FEDCU, 0x36720755U, 0x363E3180U, 0x361575ABU, 0x35EAE655U,
    0x35B8975DU, 0x35910EAEU, 0x3563FB18U, 0x35332777U, 0x350CC8E3U, 0x34DD4405U, 0x34ADE091U, 0x3488A34FU,
};
float inv_freq(unsigned f) {
    float v;
    std::memcpy(&v, &kInvFreqBits[f], sizeof v);
    return v;
}

void ck(hipError_t e, const char* what) {
    if (e != hipSuccess) throw std::runtime_error(std::string("te gpu: ") + what + ": " + hipGetErrorString(e));
}
void launched(const char* what) { ck(hipGetLastError(), what); }

struct DeviceBuffer {
    void* p = nullptr;
    std::size_t n = 0;
    DeviceBuffer() = default;
    explicit DeviceBuffer(std::size_t bytes) : n(bytes) {
        if (bytes) ck(hipMalloc(&p, bytes), "hipMalloc");
    }
    DeviceBuffer(DeviceBuffer&& o) noexcept : p(o.p), n(o.n) { o.p = nullptr; o.n = 0; }
    DeviceBuffer& operator=(DeviceBuffer&& o) noexcept {
        if (this != &o) { release(); p = o.p; n = o.n; o.p = nullptr; o.n = 0; }
        return *this;
    }
    ~DeviceBuffer() { release(); }
    void release() { if (p) (void)hipFree(p); p = nullptr; n = 0; }
    template <typename T> T* as() const { return static_cast<T*>(p); }
};

// ---------------------------------------------------------------------------------------------
// weight expansion: codes [N][K/2] (element 2j in the high nibble) + e4m3 block scales [N][K/16]
// -> FP16 panels [N/16][K/16][16 n][16 k], value e2m1 * e4m3 (exact in FP16).
__device__ float e4m3_value(unsigned b) {
    const unsigned e = (b >> 3U) & 15U, m = b & 7U;
    const float v = e == 0U ? ldexpf(float(m), -9) : ldexpf(float(8U + m), int(e) - 10);
    return (b & 0x80U) ? -v : v;
}
// Store a GEMM input value: FP16 hi part, and when plane != 0 the FP16 residual lo = f16(v - hi)
// at idx + plane (split-A: hi + lo carries ~21 significant bits of the FP32 activation).
// Split operands: lo = f16((v - hi) * 2^11), i.e. the residual is stored x 2^11 so that it stays in
// the FP16 normal range (an unscaled residual of a value below ~0.06 is FP16-subnormal and loses
// bits); the consumers accumulate lo terms in separate chains and scale them by 2^-11 in FP32.
constexpr float kLoScale = 2048.0F;
__device__ inline void put(_Float16* out, std::size_t idx, float v, std::size_t plane) {
    const _Float16 hi = static_cast<_Float16>(v);
    out[idx] = hi;
    if (plane) out[idx + plane] = static_cast<_Float16>((v - static_cast<float>(hi)) * kLoScale);
}
__device__ inline void put_att(_Float16* out, std::size_t idx, float v, std::size_t plane) { put(out, idx, v, plane); }

__constant__ float kE2m1[16] = {0.0F, 0.5F, 1.0F, 1.5F, 2.0F, 3.0F, 4.0F, 6.0F,
                                -0.0F, -0.5F, -1.0F, -1.5F, -2.0F, -3.0F, -4.0F, -6.0F};

__global__ void expand_kernel(const unsigned char* codes, const unsigned char* bscale, unsigned n_rows, unsigned k,
                              _Float16* panels) {
    const unsigned kb_count = k / 16U;
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;  // one (row, k16 block)
    if (i >= std::size_t(n_rows) * kb_count) return;
    const unsigned n = unsigned(i / kb_count), kb = unsigned(i % kb_count);
    const float s = e4m3_value(bscale[i]);
    const unsigned char* c = codes + std::size_t(n) * (k / 2U) + kb * 8U;
    _Float16 v[16];
#pragma unroll
    for (unsigned j = 0; j < 8; ++j) {
        const unsigned b = c[j];
        v[2 * j] = static_cast<_Float16>(kE2m1[b >> 4U] * s);
        v[2 * j + 1] = static_cast<_Float16>(kE2m1[b & 15U] * s);
    }
    _Float16* dst = panels + ((std::size_t(n / 16U) * kb_count + kb) * 256U + (n % 16U) * 16U);
#pragma unroll
    for (unsigned j = 0; j < 16; ++j) dst[j] = v[j];
}

// ---------------------------------------------------------------------------------------------
// GEMM: out[r][n] (=|+=) scale[n] * sum_k A[r][k] * W[n][k]. A: FP16 panels [K/16][rows][16];
// W: FP16 panels [N/16][K/16][16][16]. 128 rows x 256 outputs per workgroup of 8 waves, K32 LDS
// double buffering; every output is one increasing K16 WMMA chain from +0 (row-count invariant).
// Requires K % 32 == 0. Epilogue: v = acc * scale[n] (+ bias[n]); out = v or out + v.
// Split: A is hi + lo planes (lo at x + rows * stride); per K16 step the chain issues hi then lo.
template <bool Accumulate, bool Split>
__global__ __launch_bounds__(256) void gemm_kernel(const _Float16* weights, const _Float16* x, unsigned rows,
                                                   unsigned outputs, unsigned stride, const float* scale,
                                                   const float* bias, float* out) {
    // per wave 64 rows x (16 * JN) outputs; the split form keeps a second (lo) accumulator set
    constexpr unsigned JN = Split ? 2 : 4;
    constexpr unsigned WavesN = 4, threads = 256, tile_m = 128, tile_n = 16 * JN * WavesN;
    constexpr unsigned a_loads = tile_m * 32 / 8 / threads, b_loads = tile_n * 32 / 8 / threads;
    constexpr unsigned planes = Split ? 2 : 1;
    __shared__ _Float16 la[2][planes][2][tile_m * 16], lb[2][2][tile_n * 16];
    const unsigned tid = threadIdx.x, lane = tid % 32, wave = tid / 32;
    const unsigned m_tile = blockIdx.y * tile_m, n_tile = blockIdx.x * tile_n;
    const unsigned wm = (wave / WavesN) * 64, wn = (wave % WavesN) * 16 * JN;
    const unsigned k16s = stride / 16, n16s = (outputs + 15U) / 16U;
    const std::size_t plane = std::size_t(rows) * stride;
    Vec4 ra[planes][a_loads], rb[b_loads];
    auto fetch = [&](unsigned k0) {
#pragma unroll
        for (unsigned i = 0; i < a_loads; ++i) {
            const unsigned v = tid + i * threads, h = v / (tile_m * 2), row = (v / 2) % tile_m, part = v % 2;
            const unsigned r = m_tile + row;
#pragma unroll
            for (unsigned pl = 0; pl < planes; ++pl)
                ra[pl][i] = r < rows ? *reinterpret_cast<const Vec4*>(x + pl * plane + (std::size_t(k0 / 16 + h) * rows + r) * 16 + part * 8)
                                     : Vec4{};
        }
#pragma unroll
        for (unsigned i = 0; i < b_loads; ++i) {
            const unsigned v = tid + i * threads, h = v / (tile_n * 2), n = (v / 2) % tile_n, part = v % 2;
            const unsigned j = (n_tile + n) / 16;
            rb[i] = j < n16s ? *reinterpret_cast<const Vec4*>(weights + (std::size_t(j) * k16s + k0 / 16 + h) * 256 + (n % 16) * 16 + part * 8)
                             : Vec4{};
        }
    };
    auto store = [&](unsigned slot) {
#pragma unroll
        for (unsigned i = 0; i < a_loads; ++i) {
            const unsigned v = tid + i * threads, h = v / (tile_m * 2), row = (v / 2) % tile_m, part = v % 2;
#pragma unroll
            for (unsigned pl = 0; pl < planes; ++pl) *reinterpret_cast<Vec4*>(&la[slot][pl][h][row * 16 + part * 8]) = ra[pl][i];
        }
#pragma unroll
        for (unsigned i = 0; i < b_loads; ++i) {
            const unsigned v = tid + i * threads, h = v / (tile_n * 2), n = (v / 2) % tile_n, part = v % 2;
            *reinterpret_cast<Vec4*>(&lb[slot][h][n * 16 + part * 8]) = rb[i];
        }
    };
    Float8 c[4][JN]{};
    Float8 cl[Split ? 4 : 1][Split ? JN : 1]{};
    fetch(0);
    store(0);
    __syncthreads();
    for (unsigned k0 = 0; k0 < stride; k0 += 32) {
        const unsigned slot = (k0 / 32) % 2;
        if (k0 + 32 < stride) fetch(k0 + 32);
#pragma unroll
        for (unsigned h = 0; h < 2; ++h) {
            Half16 b[JN];
#pragma unroll
            for (unsigned j = 0; j < JN; ++j) b[j] = *reinterpret_cast<const Half16*>(&lb[slot][h][(wn + j * 16 + lane % 16) * 16]);
            {
                Half16 a[4];
#pragma unroll
                for (unsigned i = 0; i < 4; ++i) a[i] = *reinterpret_cast<const Half16*>(&la[slot][0][h][(wm + i * 16 + lane % 16) * 16]);
#pragma unroll
                for (unsigned i = 0; i < 4; ++i)
#pragma unroll
                    for (unsigned j = 0; j < JN; ++j)
                        c[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(a[i], b[j], c[i][j]);
            }
            if constexpr (Split) {
                Half16 a[4];
#pragma unroll
                for (unsigned i = 0; i < 4; ++i) a[i] = *reinterpret_cast<const Half16*>(&la[slot][planes - 1][h][(wm + i * 16 + lane % 16) * 16]);
#pragma unroll
                for (unsigned i = 0; i < 4; ++i)
#pragma unroll
                    for (unsigned j = 0; j < JN; ++j)
                        cl[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(a[i], b[j], cl[i][j]);
            }
        }
        if (k0 + 32 < stride) store(slot ^ 1U);
        __syncthreads();
    }
#pragma unroll
    for (unsigned i = 0; i < 4; ++i)
#pragma unroll
        for (unsigned j = 0; j < JN; ++j)
#pragma unroll
            for (unsigned e = 0; e < 8; ++e) {
                const unsigned r = m_tile + wm + i * 16 + 2 * e + lane / 16, n = n_tile + wn + j * 16 + lane % 16;
                if (r < rows && n < outputs) {
                    float acc = c[i][j][e];
                    if constexpr (Split) acc = acc + cl[i][j][e] * (1.0F / kLoScale);
                    float v = acc * scale[n];
                    if (bias) v = v + bias[n];
                    float* o = out + std::size_t(r) * outputs + n;
                    if (Accumulate) *o = *o + v;
                    else *o = v;
                }
            }
}

// ---------------------------------------------------------------------------------------------
// RMSNorm of one 5120 row (FP32, fixed-order reduction) -> FP16 GEMM input panels.
__global__ __launch_bounds__(256) void rmsnorm_panels(const float* x, const float* w, unsigned rows, _Float16* out,
                                                     std::size_t plane) {
    __shared__ float part[256];
    const unsigned r = blockIdx.x, t = threadIdx.x;
    const float* xr = x + std::size_t(r) * kHidden;
    float s = 0.0F;
    for (unsigned c = t; c < kHidden; c += 256) s += xr[c] * xr[c];
    part[t] = s;
    __syncthreads();
    for (unsigned d = 128; d; d >>= 1U) {
        if (t < d) part[t] += part[t + d];
        __syncthreads();
    }
    const float inv = 1.0F / sqrtf(part[0] / float(kHidden) + kEps);
    for (unsigned c = t; c < kHidden; c += 256)
        put(out, (std::size_t(c / 16U) * rows + r) * 16U + c % 16U, xr[c] * inv * w[c], plane);
}

// q/k per-head RMSNorm + split-half RoPE (FP32), v copy; FP16 out [head][padded rows][128].
__global__ __launch_bounds__(128) void qk_norm_rope(const float* qkv, const float* qn, const float* kn,
                                                   const float* cosv, const float* sinv, unsigned padded,
                                                   _Float16* q, _Float16* k, _Float16* v, std::size_t qplane,
                                                   std::size_t kvplane) {
    __shared__ float y[kHeadDim];
    __shared__ float part[kHeadDim];
    const unsigned r = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
    const float x = qkv[std::size_t(r) * kQkv + h * kHeadDim + d];
    if (h >= kHeads + kKvHeads) {
        put_att(v, (std::size_t(h - kHeads - kKvHeads) * padded + r) * kHeadDim + d, x, kvplane);
        return;
    }
    part[d] = x * x;
    __syncthreads();
    for (unsigned s = 64; s; s >>= 1U) {
        if (d < s) part[d] += part[d + s];
        __syncthreads();
    }
    const float inv = 1.0F / sqrtf(part[0] / float(kHeadDim) + kEps);
    const float* w = h < kHeads ? qn : kn;
    y[d] = x * inv * w[d];
    __syncthreads();
    const unsigned f = d % 64U;
    const float c = cosv[std::size_t(r) * 64 + f], s = sinv[std::size_t(r) * 64 + f];
    const float rot = d < 64U ? -y[d + 64U] : y[d - 64U];
    const float o = y[d] * c + rot * s;
    if (h < kHeads) put_att(q, (std::size_t(h) * padded + r) * kHeadDim + d, o, qplane);
    else put_att(k, (std::size_t(h - kHeads) * padded + r) * kHeadDim + d, o, kvplane);
}

// Flash attention, head dim Dim (multiple of 16, zero-padded beyond the model's head dim), Group
// query heads per KV head. One workgroup = 16 query rows x the Group query heads of one KV head (one
// wave each); key blocks of 32 in increasing order from key 0 (a row's result does not depend on
// the sequence length beyond its own key range). Causal: key <= query; otherwise key < rows.
// Scores and online softmax in FP32, P rounded to FP16 (the row sum uses the rounded P).
// Epilogue: o / l (* prescale) -> FP16 panels [K/16][rows][16] of the projection input, column
// h * out_dim + d for d < out_dim. q/k/v: [head][padded rows][Dim] FP16.
// Split: Q, K, V carry hi + lo FP16 planes (lo plane at +qplane / +kvplane elements, lo stored
// x 2^11 so that it stays in the FP16 normal range), P is split the same way. The lo cross terms
// are accumulated in their own chains, never in the hi chain:
//   S  = chain_kd(qh.kh) + 2^-11 * chain_kd(qh.kl', ql'.kh)
//   O += chain_kk(ph.vh) and, per block, 2^-11 * chain_kk(ph.vl', pl'.vh)      (lo.lo dropped)
// in that fixed order; the row sum uses ph + 2^-11 pl'.
// probe taps (tests only): when g_att_dbg != nullptr, head 0 / row g_att_dbg_row writes per key block kb at
// dbg + kb * 512: [0,32) masked scaled scores, [32,64) hi scores before the lo add, [64,96) lo chain,
// [96,128) P (hi + lo/2^11), [128] m, [129] l, [256,256+Dim) o after the block.
__device__ float* g_att_dbg = nullptr;
__device__ unsigned g_att_dbg_row = 0;
template <unsigned Dim, unsigned Group, bool Causal, bool Split, bool SplitS = Split, bool SplitO = Split>
__global__ __launch_bounds__(Group * 32) void attention_kernel(const _Float16* q, const _Float16* k, const _Float16* v,
                                                              unsigned rows, unsigned padded, float scale,
                                                              unsigned out_dim, const float* prescale, _Float16* out,
                                                              std::size_t plane, std::size_t qplane, std::size_t kvplane) {
    constexpr unsigned DT = Dim / 16, threads = Group * 32, NP = Split ? 2 : 1;
    constexpr float kLoInv = 1.0F / kLoScale;
    __shared__ _Float16 ks[NP][32][Dim];
    __shared__ _Float16 vt[NP][Dim][32];
    __shared__ _Float16 ps[NP][Group][16][32];
    const unsigned tid = threadIdx.x, lane = tid % 32, wave = tid / 32;
    const unsigned q0 = blockIdx.x * 16, g = blockIdx.y, h = g * Group + wave;
    // Q hi stays in registers; Q lo (split) is re-read per key block (keeps the kernel free of spills)
    const _Float16* qrow = q + (std::size_t(h) * padded + q0 + lane % 16) * Dim;
    Half16 aq[DT];
#pragma unroll
    for (unsigned kd = 0; kd < DT; ++kd) aq[kd] = *reinterpret_cast<const Half16*>(qrow + kd * 16);
    Float8 o[DT]{};
    float m[8], l[8];
#pragma unroll
    for (unsigned e = 0; e < 8; ++e) { m[e] = -INFINITY; l[e] = 0.0F; }
    const unsigned kend = Causal ? min(q0 + 16U, rows) : rows, blocks = (kend + 31U) / 32U;
    for (unsigned kb = 0; kb < blocks; ++kb) {
        __syncthreads();
        for (unsigned i = tid; i < NP * 32 * Dim / 8; i += threads) {  // 8 halves per step
            const unsigned pl = i / (32 * Dim / 8), j0 = i % (32 * Dim / 8);
            const unsigned key = j0 / (Dim / 8), d0 = (j0 % (Dim / 8)) * 8;
            const std::size_t src = pl * kvplane + (std::size_t(g) * padded + kb * 32 + key) * Dim + d0;
            // causal: keys past the tile's last query are masked for every row; load them as zeros so
            // that no WMMA ever sees their values (a zero P entry does not make the WMMA result
            // independent of the matching V entry on this hardware, see the probe notes)
            const bool dead = Causal && kb * 32 + key > q0 + 15U;
            *reinterpret_cast<Vec4*>(&ks[pl][key][d0]) = dead ? Vec4{} : *reinterpret_cast<const Vec4*>(k + src);
            const Vec4 vv = dead ? Vec4{} : *reinterpret_cast<const Vec4*>(v + src);
            const _Float16* vh = reinterpret_cast<const _Float16*>(&vv);
#pragma unroll
            for (unsigned j = 0; j < 8; ++j) vt[pl][d0 + j][key] = vh[j];
        }
        __syncthreads();
        Float8 s[2];
#pragma unroll
        for (unsigned t = 0; t < 2; ++t) {
            s[t] = Float8{};
#pragma unroll
            for (unsigned kd = 0; kd < DT; ++kd) {
                const Half16 bh = *reinterpret_cast<const Half16*>(&ks[0][t * 16 + lane % 16][kd * 16]);
                s[t] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(aq[kd], bh, s[t]);
            }
            if (g_att_dbg && h == 0)
#pragma unroll
                for (unsigned e = 0; e < 8; ++e)
                    if (q0 + 2 * e + lane / 16 == g_att_dbg_row) g_att_dbg[kb * 512 + 32 + t * 16 + lane % 16] = s[t][e];
            if constexpr (SplitS) {
                Float8 lo{};
#pragma unroll
                for (unsigned kd = 0; kd < DT; ++kd) {
                    const Half16 bh = *reinterpret_cast<const Half16*>(&ks[0][t * 16 + lane % 16][kd * 16]);
                    const Half16 bl = *reinterpret_cast<const Half16*>(&ks[NP - 1][t * 16 + lane % 16][kd * 16]);
                    const Half16 ql = *reinterpret_cast<const Half16*>(qrow + qplane + kd * 16);
                    lo = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(aq[kd], bl, lo);
                    lo = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(ql, bh, lo);
                }
                if (g_att_dbg && h == 0)
#pragma unroll
                    for (unsigned e = 0; e < 8; ++e)
                        if (q0 + 2 * e + lane / 16 == g_att_dbg_row) g_att_dbg[kb * 512 + 64 + t * 16 + lane % 16] = lo[e];
#pragma unroll
                for (unsigned e = 0; e < 8; ++e) s[t][e] = s[t][e] + lo[e] * kLoInv;
            }
        }
#pragma unroll
        for (unsigned e = 0; e < 8; ++e) {
            const unsigned qi = q0 + 2 * e + lane / 16;
            float bm = -INFINITY;
#pragma unroll
            for (unsigned t = 0; t < 2; ++t) {
                const unsigned key = kb * 32 + t * 16 + lane % 16;
                const bool ok = Causal ? key <= qi : key < rows;
                const float val = ok ? s[t][e] * scale : -INFINITY;
                s[t][e] = val;
                bm = fmaxf(bm, val);
            }
            for (unsigned d = 1; d < 16; d <<= 1U) bm = fmaxf(bm, __shfl_xor(bm, d, 32));
            const float mn = fmaxf(m[e], bm);
            const float alpha = m[e] == -INFINITY ? 0.0F : expf(m[e] - mn);
            float sum = 0.0F;
#pragma unroll
            for (unsigned t = 0; t < 2; ++t) {
                const float p = s[t][e] == -INFINITY ? 0.0F : expf(s[t][e] - mn);
                const _Float16 ph = static_cast<_Float16>(p);
                ps[0][wave][2 * e + lane / 16][t * 16 + lane % 16] = ph;
                float pv = static_cast<float>(ph);
                if constexpr (SplitO) {
                    const _Float16 plo = static_cast<_Float16>((p - pv) * kLoScale);
                    ps[NP - 1][wave][2 * e + lane / 16][t * 16 + lane % 16] = plo;
                    pv = pv + static_cast<float>(plo) * kLoInv;
                }
                if (g_att_dbg && h == 0 && qi == g_att_dbg_row) {
                    g_att_dbg[kb * 512 + t * 16 + lane % 16] = s[t][e];
                    g_att_dbg[kb * 512 + 96 + t * 16 + lane % 16] = pv;
                }
                sum += pv;
            }
            for (unsigned d = 1; d < 16; d <<= 1U) sum += __shfl_xor(sum, d, 32);
            l[e] = l[e] * alpha + sum;
            m[e] = mn;
            if (g_att_dbg && h == 0 && qi == g_att_dbg_row && lane % 16 == 0) {
                g_att_dbg[kb * 512 + 128] = mn;
                g_att_dbg[kb * 512 + 129] = l[e];
            }
#pragma unroll
            for (unsigned dt = 0; dt < DT; ++dt) o[dt][e] *= alpha;
        }
        __syncthreads();
        Half16 aph[2], apl[2];
#pragma unroll
        for (unsigned kk = 0; kk < 2; ++kk) {
            aph[kk] = *reinterpret_cast<const Half16*>(&ps[0][wave][lane % 16][kk * 16]);
            if constexpr (SplitO) apl[kk] = *reinterpret_cast<const Half16*>(&ps[NP - 1][wave][lane % 16][kk * 16]);
        }
        // causal diagonal slice (keys q0..q0+15, masked per row above the diagonal): explicit FP32 sums
        // over each row's own keys 0..row, ascending, so masked V entries are never touched
        const unsigned diag_kk = Causal && kb * 32 <= q0 && q0 < kb * 32 + 32 ? (q0 - kb * 32) / 16 : 2U;
#pragma unroll
        for (unsigned dt = 0; dt < DT; ++dt) {
            Float8 lo{};
#pragma unroll
            for (unsigned kk = 0; kk < 2; ++kk) {
                if (kk == diag_kk) continue;
                const Half16 bh = *reinterpret_cast<const Half16*>(&vt[0][dt * 16 + lane % 16][kk * 16]);
                o[dt] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(aph[kk], bh, o[dt]);
                if constexpr (SplitO) {
                    const Half16 bl = *reinterpret_cast<const Half16*>(&vt[NP - 1][dt * 16 + lane % 16][kk * 16]);
                    lo = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(aph[kk], bl, lo);
                    lo = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(apl[kk], bh, lo);
                }
            }
            if constexpr (SplitO) {
#pragma unroll
                for (unsigned e = 0; e < 8; ++e) o[dt][e] = o[dt][e] + lo[e] * kLoInv;
            }
            if (diag_kk < 2U) {
                const unsigned d = dt * 16 + lane % 16;
#pragma unroll
                for (unsigned e = 0; e < 8; ++e) {
                    const unsigned row = 2 * e + lane / 16;  // tile row; keys q0..q0+row are visible
                    float acc = 0.0F;
                    for (unsigned j = 0; j <= row; ++j) {
                        const unsigned kc = diag_kk * 16 + j;
                        float pj = static_cast<float>(ps[0][wave][row][kc]);
                        float vj = static_cast<float>(vt[0][d][kc]);
                        if constexpr (SplitO) {
                            pj = pj + static_cast<float>(ps[NP - 1][wave][row][kc]) * kLoInv;
                            vj = vj + static_cast<float>(vt[NP - 1][d][kc]) * kLoInv;
                        }
                        acc = acc + pj * vj;
                    }
                    o[dt][e] = o[dt][e] + acc;
                }
            }
        }
        if (g_att_dbg && h == 0)
#pragma unroll
            for (unsigned e = 0; e < 8; ++e)
                if (q0 + 2 * e + lane / 16 == g_att_dbg_row)
#pragma unroll
                    for (unsigned dt = 0; dt < DT; ++dt) g_att_dbg[kb * 512 + 256 + dt * 16 + lane % 16] = o[dt][e];
    }
#pragma unroll
    for (unsigned e = 0; e < 8; ++e) {
        const unsigned r = q0 + 2 * e + lane / 16;
        if (r >= rows) continue;
#pragma unroll
        for (unsigned dt = 0; dt < DT; ++dt) {
            const unsigned d = dt * 16 + lane % 16;
            if (d >= out_dim) continue;
            const unsigned c = h * out_dim + d;
            float val = o[dt][e] / l[e];
            if (prescale) val = val * prescale[c];
            put(out, (std::size_t(c / 16U) * rows + r) * 16U + c % 16U, val, plane);
        }
    }
}

// silu(gate) * up * prescale (FP32) -> FP16 panels of the down_proj input.
__global__ void swiglu_panels(const float* gu, const float* prescale, unsigned rows, _Float16* out, std::size_t plane) {
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i >= std::size_t(rows) * kFfn) return;
    const unsigned r = unsigned(i / kFfn), c = unsigned(i % kFfn);
    const float g = gu[std::size_t(r) * (2 * kFfn) + c], u = gu[std::size_t(r) * (2 * kFfn) + kFfn + c];
    const float y = g / (1.0F + expf(-g)) * u * prescale[c];
    put(out, (std::size_t(c / 16U) * rows + r) * 16U + c % 16U, y, plane);
}

// debug: one row of FP16 GEMM input panels (hi + lo / 2^11 when split) -> FP32
__global__ void panel_row(const _Float16* a, unsigned rows, unsigned k, unsigned row, std::size_t plane, float* out) {
    const unsigned c = blockIdx.x * blockDim.x + threadIdx.x;
    if (c >= k) return;
    const std::size_t i = (std::size_t(c / 16U) * rows + row) * 16U + c % 16U;
    float v = static_cast<float>(a[i]);
    if (plane) v = v + static_cast<float>(a[i + plane]) * (1.0F / kLoScale);
    out[c] = v;
}

// x[rows[i]] += add[i] after decoder layers 0..2 (vision prompts)
__global__ void deepstack_add(float* x, const float* add, const std::uint32_t* rows, unsigned n) {
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i >= std::size_t(n) * kHidden) return;
    const std::size_t v = i / kHidden, c = i % kHidden;
    float* p = x + std::size_t(rows[v]) * kHidden + c;
    *p = *p + add[i];
}

// ---------------------------------------------------------------------------------------------
// Vision tower kernels.
// bf16 weight [n][k] -> FP16 panels with K stride `stride` (zero padded), values * 2^shift (power of
// two, exact; undone by the GEMM scale vector). bf16 -> f16 is exact inside the f16 normal range.
__global__ void bf16_panels(const std::uint16_t* w, unsigned n_rows, unsigned k, unsigned stride, float mult,
                            _Float16* panels) {
    const unsigned kb_count = stride / 16U;
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    const unsigned n16 = (n_rows + 15U) / 16U * 16U;
    if (i >= std::size_t(n16) * kb_count) return;
    const unsigned n = unsigned(i / kb_count), kb = unsigned(i % kb_count);
    _Float16* dst = panels + ((std::size_t(n / 16U) * kb_count + kb) * 256U + (n % 16U) * 16U);
#pragma unroll
    for (unsigned j = 0; j < 16; ++j) {
        const unsigned kk = kb * 16U + j;
        float f = 0.0F;
        if (n < n_rows && kk < k) f = __builtin_bit_cast(float, unsigned(w[std::size_t(n) * k + kk]) << 16U) * mult;
        dst[j] = static_cast<_Float16>(f);
    }
}

// FP32 rows [rows][k] -> FP16 panels with stride (zero padded)
__global__ void f32_panels(const float* x, unsigned rows, unsigned k, unsigned stride, _Float16* out, std::size_t plane) {
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i >= std::size_t(rows) * stride) return;
    const unsigned r = unsigned(i / stride), c = unsigned(i % stride);
    put(out, (std::size_t(c / 16U) * rows + r) * 16U + c % 16U, c < k ? x[std::size_t(r) * k + c] : 0.0F, plane);
}

// LayerNorm (FP32, two-pass mean / variance, fixed-order reductions) of input row r (width floats)
// -> FP16 panels: output row r / group, column (r % group) * width + c; out_rows = rows / group.
__global__ __launch_bounds__(256) void layernorm_panels(const float* x, unsigned width, const float* w, const float* b,
                                                       unsigned group, unsigned out_rows, _Float16* out,
                                                       std::size_t plane) {
    __shared__ float part[256];
    const unsigned r = blockIdx.x, t = threadIdx.x;
    const float* xr = x + std::size_t(r) * width;
    float s = 0.0F;
    for (unsigned c = t; c < width; c += 256) s += xr[c];
    part[t] = s;
    __syncthreads();
    for (unsigned d = 128; d; d >>= 1U) { if (t < d) part[t] += part[t + d]; __syncthreads(); }
    const float mean = part[0] / float(width);
    __syncthreads();
    s = 0.0F;
    for (unsigned c = t; c < width; c += 256) { const float d = xr[c] - mean; s += d * d; }
    part[t] = s;
    __syncthreads();
    for (unsigned d = 128; d; d >>= 1U) { if (t < d) part[t] += part[t + d]; __syncthreads(); }
    const float inv = 1.0F / sqrtf(part[0] / float(width) + 1e-6F);
    const unsigned orow = r / group, coff = (r % group) * width;
    for (unsigned c = t; c < width; c += 256) {
        const unsigned col = coff + c;
        put(out, (std::size_t(col / 16U) * out_rows + orow) * 16U + col % 16U, (xr[c] - mean) * inv * w[c] + b[c], plane);
    }
}

__global__ void add_rows(float* x, const float* a, std::size_t n) {
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i < n) x[i] = x[i] + a[i];
}

// Vision q/k/v: qkv [rows][3 * 1152] (head h dims h*72..), split-half RoPE over 72 dims (q, k),
// FP16 out [16][padded][80] zero-padded beyond 72.
__global__ void vision_qkv(const float* qkv, const float* cosv, const float* sinv, unsigned rows, unsigned padded,
                           _Float16* q, _Float16* k, _Float16* v, std::size_t vplane) {
    constexpr unsigned H = 16, D = 72, DP = 80, W = 1152;
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i >= std::size_t(rows) * 3 * H * DP) return;
    const unsigned d = unsigned(i % DP), h = unsigned(i / DP % H), part = unsigned(i / (DP * H) % 3), r = unsigned(i / (DP * H * 3));
    float o = 0.0F;
    if (d < D) {
        const float* src = qkv + std::size_t(r) * 3 * W + part * W + h * D;
        if (part == 2) o = src[d];
        else {
            const float c = cosv[std::size_t(r) * 36 + d % 36], sn = sinv[std::size_t(r) * 36 + d % 36];
            const float rot = d < 36U ? -src[d + 36U] : src[d - 36U];
            o = src[d] * c + rot * sn;
        }
    }
    _Float16* dst = part == 0 ? q : part == 1 ? k : v;
    put_att(dst, (std::size_t(h) * padded + r) * DP + d, o, vplane);
}

// GELU (tanh or erf form) of [rows][n] FP32 -> FP16 panels with K stride (zero padded beyond n).
template <bool Tanh>
__global__ void gelu_panels(const float* x, unsigned rows, unsigned n, unsigned stride, _Float16* out, std::size_t plane) {
    const std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i >= std::size_t(rows) * stride) return;
    const unsigned r = unsigned(i / stride), c = unsigned(i % stride);
    float y = 0.0F;
    if (c < n) {
        const float a = x[std::size_t(r) * n + c];
        if (Tanh) {
            const float kBeta = 0.7978845608028654F, kKappa = 0.044715F;
            y = 0.5F * a * (1.0F + tanhf(kBeta * (a + kKappa * a * a * a)));
        } else {
            y = 0.5F * a * (1.0F + erff(a * 0.7071067811865476F));
        }
    }
    put(out, (std::size_t(c / 16U) * rows + r) * 16U + c % 16U, y, plane);
}

// ---------------------------------------------------------------------------------------------
struct Linear {
    DeviceBuffer codes, bscale;
    unsigned n = 0, k = 0;
    float tscale = 0;
};

struct Layer {
    Linear q, k, v, o, gate, up, down;
    DeviceBuffer attn_norm, ffn_norm, q_norm, k_norm, o_prescale, down_prescale;
    DeviceBuffer scale_qkv, scale_o, scale_gu, scale_down;  // per-output FP32 tensor scales
};

// float -> bf16 (round to nearest even) -> float; inputs are finite
float round_bf16(float f) {
    std::uint32_t u;
    std::memcpy(&u, &f, sizeof u);
    u = (u + 0x7FFFU + ((u >> 16U) & 1U)) & 0xFFFF0000U;
    std::memcpy(&f, &u, sizeof f);
    return f;
}

DeviceBuffer upload(const void* src, std::size_t bytes) {
    DeviceBuffer b(bytes);
    ck(hipMemcpy(b.p, src, bytes, hipMemcpyHostToDevice), "upload");
    return b;
}

DeviceBuffer upload_bf16_as_float(const SafetensorsFile& f, const std::string& name, std::int64_t n) {
    const auto raw = f.read_vector<std::uint16_t>(name, "BF16", {n});
    std::vector<float> v(raw.size());
    for (std::size_t i = 0; i < raw.size(); ++i) v[i] = bf16_to_float(raw[i]);
    return upload(v.data(), v.size() * sizeof(float));
}

// Every tensor's dtype and full shape is checked before anything is allocated or uploaded.
Linear load_linear(const SafetensorsFile& f, const std::string& name, unsigned n, unsigned k) {
    Linear l;
    l.n = n;
    l.k = k;
    const auto codes = f.read_vector<std::uint8_t>("blk." + name + ".codes", "U8", {n, k / 2});
    const auto bscale = f.read_vector<std::uint8_t>("blk." + name + ".bscale", "U8", {n, k / 16});
    l.tscale = f.read_f32_scalar("blk." + name + ".tscale");
    if (!std::isfinite(l.tscale) || !(l.tscale > 0.0F)) throw PackError("te pack: blk." + name + ".tscale is not a positive finite value");
    l.codes = upload(codes.data(), codes.size());
    l.bscale = upload(bscale.data(), bscale.size());
    return l;
}

DeviceBuffer scale_vector(std::initializer_list<const Linear*> parts) {
    std::vector<float> s;
    for (const auto* p : parts) s.insert(s.end(), p->n, p->tscale);
    return upload(s.data(), s.size() * sizeof(float));
}

}  // namespace

struct TextEncoder::Impl {
    std::vector<Layer> layers;
    std::vector<std::int8_t> embed_q;
    std::vector<float> embed_scale;
    DeviceBuffer w_qkv, w_o, w_gu, w_down;  // FP16 panels of the current layer
    double load_s = 0;
    std::string pack_sha256;
    std::uint64_t bytes = 0;
    hipStream_t stream = nullptr;
    int debug_layer = -1, debug_stage = 0;
    int replay_first = 0;      // debug: start the layer loop here (the input is that layer's residual)
    bool replay_ffn = false;   // debug: skip the attention block of layer replay_first
    int tap_row = -1;
    bool tap_sub = false;
    std::vector<float> taps;

    void expand(const Linear& l, _Float16* dst) const {
        const std::size_t blocks = std::size_t(l.n) * (l.k / 16U);
        hipLaunchKernelGGL(expand_kernel, dim3(unsigned((blocks + 255) / 256)), dim3(256), 0, stream,
                           l.codes.as<unsigned char>(), l.bscale.as<unsigned char>(), l.n, l.k, dst);
        launched("expand");
    }
    void expand_layer(const Layer& L) const {
        expand(L.q, w_qkv.as<_Float16>());
        expand(L.k, w_qkv.as<_Float16>() + std::size_t(L.q.n) * kHidden);
        expand(L.v, w_qkv.as<_Float16>() + std::size_t(L.q.n + L.k.n) * kHidden);
        expand(L.o, w_o.as<_Float16>());
        expand(L.gate, w_gu.as<_Float16>());
        expand(L.up, w_gu.as<_Float16>() + std::size_t(kFfn) * kHidden);
        expand(L.down, w_down.as<_Float16>());
    }
    bool split = true;  // hi + lo FP16 activations (GEMM inputs, Q/K/V, P)
    template <bool Acc>
    void gemm(const _Float16* w, const _Float16* x, unsigned rows, unsigned n, unsigned k, const float* scale,
              float* out, const float* bias = nullptr) const {
        if (k % 32U) throw std::invalid_argument("te gemm: K % 32");
        if (split)
            hipLaunchKernelGGL((gemm_kernel<Acc, true>), dim3((n + 127U) / 128U, (rows + 127U) / 128U), dim3(256), 0, stream,
                               w, x, rows, n, k, scale, bias, out);
        else
            hipLaunchKernelGGL((gemm_kernel<Acc, false>), dim3((n + 255U) / 256U, (rows + 127U) / 128U), dim3(256), 0, stream,
                               w, x, rows, n, k, scale, bias, out);
        launched("gemm");
    }
};

// te-pack.json checks shared by the text encoder and the vision tower, plus the file hashes, which run on
// host threads while the weights load (joined before load() returns; also joined when load() throws).
class PackCheck {
public:
    PackCheck(const std::string& dir, std::vector<std::string> names) : dir_(dir), m_(read_pack_manifest(dir)) {
        if (m_.format != "h3-te-pack-1") throw PackError("te pack: format " + m_.format + ", expected h3-te-pack-1");
        verify_pack_files(dir_, m_, names, false);  // listed + exact byte counts, now
        if (pack_hash_verification_enabled())
            t_ = std::thread([this, names = std::move(names)] {
                try {
                    verify_pack_files(dir_, m_, names, true, std::max(2U, std::min(8U, std::thread::hardware_concurrency())));
                } catch (...) {
                    err_ = std::current_exception();
                }
            });
    }
    PackCheck(const PackCheck&) = delete;
    PackCheck& operator=(const PackCheck&) = delete;
    ~PackCheck() { if (t_.joinable()) t_.join(); }
    [[nodiscard]] const PackManifest& manifest() const { return m_; }
    void finish() {
        if (t_.joinable()) t_.join();
        if (err_) std::rethrow_exception(err_);
    }

private:
    std::string dir_;
    PackManifest m_;
    std::thread t_;
    std::exception_ptr err_;
};

TextEncoder::TextEncoder() : impl_(std::make_unique<Impl>()) {}
TextEncoder::~TextEncoder() {
    if (impl_ && impl_->stream) (void)hipStreamDestroy(impl_->stream);
}

std::unique_ptr<TextEncoder> TextEncoder::load(const std::string& dir, int n_layers) {
    const auto t0 = std::chrono::steady_clock::now();
    std::vector<std::string> names{"te-embed.safetensors"};
    if (n_layers <= 0) throw std::invalid_argument("te load: n_layers");
    for (int L = 0; L < n_layers; ++L) {
        char name[64];
        std::snprintf(name, sizeof name, "te-blk.%02d.safetensors", L);
        names.emplace_back(name);
    }
    PackCheck check(dir, names);
    {
        const auto& m = check.manifest();
        const bool geom = m.hidden == kHidden && m.ffn == kFfn && m.n_heads == kHeads && m.n_kv_heads == kKvHeads &&
                          m.head_dim == kHeadDim && m.n_layers == 50 && m.rope_theta == 5000000.0 && m.rms_eps == 1e-6 &&
                          !m.final_norm && m.mrope_interleaved && m.mrope_sections == std::vector<std::int64_t>{24, 20, 20};
        if (!geom) throw PackError("te pack: te-pack.json geometry does not match the engine (Qwen3-VL-32B, 50 layers)");
        if (n_layers > m.n_layers) throw std::invalid_argument("te load: more layers than the pack has");
    }
    std::unique_ptr<TextEncoder> te(new TextEncoder());
    auto& im = *te->impl_;
    im.pack_sha256 = check.manifest().json_sha256;
    ck(hipStreamCreateWithFlags(&im.stream, hipStreamNonBlocking), "stream");
    im.split = true;  // dense class: split activations everywhere; STRIX_H3_TE_SPLIT=0 = plain FP16 (fast class)
    if (const char* sp = std::getenv("STRIX_H3_TE_SPLIT"); sp && sp[0] == '0') im.split = false;
    {
        SafetensorsFile e(dir + "/te-embed.safetensors");
        const auto& q = e.expect("tok_embd.q", "I8", {});
        if (q.shape.size() != 2 || q.shape[1] != kHidden || q.shape[0] != check.manifest().vocab)
            throw PackError("te pack: tok_embd.q geometry");
        im.embed_q = e.read_vector<std::int8_t>("tok_embd.q", "I8", {q.shape[0], kHidden});
        im.embed_scale = e.read_vector<float>("tok_embd.scale", "F32", {q.shape[0]});
    }
    for (int L = 0; L < n_layers; ++L) {
        char name[64];
        std::snprintf(name, sizeof name, "/te-blk.%02d.safetensors", L);
        SafetensorsFile f(dir + name);
        Layer layer;
        layer.q = load_linear(f, "q", kAttn, kHidden);
        layer.k = load_linear(f, "k", kKvHeads * kHeadDim, kHidden);
        layer.v = load_linear(f, "v", kKvHeads * kHeadDim, kHidden);
        layer.o = load_linear(f, "o", kHidden, kAttn);
        layer.gate = load_linear(f, "gate", kFfn, kHidden);
        layer.up = load_linear(f, "up", kFfn, kHidden);
        layer.down = load_linear(f, "down", kHidden, kFfn);
        layer.attn_norm = upload_bf16_as_float(f, "blk.attn_norm", kHidden);
        layer.ffn_norm = upload_bf16_as_float(f, "blk.ffn_norm", kHidden);
        layer.q_norm = upload_bf16_as_float(f, "blk.q_norm", kHeadDim);
        layer.k_norm = upload_bf16_as_float(f, "blk.k_norm", kHeadDim);
        layer.o_prescale = upload_bf16_as_float(f, "blk.o.prescale", kAttn);
        layer.down_prescale = upload_bf16_as_float(f, "blk.down.prescale", kFfn);
        layer.scale_qkv = scale_vector({&layer.q, &layer.k, &layer.v});
        layer.scale_o = scale_vector({&layer.o});
        layer.scale_gu = scale_vector({&layer.gate, &layer.up});
        layer.scale_down = scale_vector({&layer.down});
        for (const auto* l : {&layer.q, &layer.k, &layer.v, &layer.o, &layer.gate, &layer.up, &layer.down})
            im.bytes += l->codes.n + l->bscale.n;
        im.layers.push_back(std::move(layer));
    }
    im.w_qkv = DeviceBuffer(std::size_t(kQkv) * kHidden * 2);
    im.w_o = DeviceBuffer(std::size_t(kHidden) * kAttn * 2);
    im.w_gu = DeviceBuffer(std::size_t(2 * kFfn) * kHidden * 2);
    im.w_down = DeviceBuffer(std::size_t(kHidden) * kFfn * 2);
    im.bytes += im.w_qkv.n + im.w_o.n + im.w_gu.n + im.w_down.n;
    check.finish();  // SHA-256 of every file read (STRIX_H3_TE_VERIFY=0 skips the hashes)
    im.load_s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
    return te;
}

double TextEncoder::load_seconds() const noexcept { return impl_->load_s; }
std::string TextEncoder::pack_digest() const { return impl_->pack_sha256; }
std::string TextEncoder::identity() const { return impl_->split ? "h3-te-lm-dense-split-v1" : "h3-te-lm-fast-f16-v1"; }
void TextEncoder::set_debug_stop(int layer, int stage) { impl_->debug_layer = layer; impl_->debug_stage = stage; }
void TextEncoder::set_replay(int first_layer, bool ffn_only) {
    if (first_layer < 0 || std::size_t(first_layer) >= impl_->layers.size()) throw std::invalid_argument("te replay: layer");
    impl_->replay_first = first_layer;
    impl_->replay_ffn = ffn_only;
}
void TextEncoder::set_row_tap(int row, bool sub) {
    impl_->tap_row = row;
    impl_->tap_sub = sub;
    impl_->taps.clear();
}
const std::vector<float>& TextEncoder::row_taps() const { return impl_->taps; }

void TextEncoder::embed_rows(const std::vector<std::int32_t>& ids, std::vector<float>& out,
                             const std::vector<float>* spliced) const {
    const auto& im = *impl_;
    out.resize(ids.size() * kHidden);
    std::size_t next = 0;
    for (std::size_t r = 0; r < ids.size(); ++r) {
        const auto id = ids[r];
        if (id == kEmbeddingRow) {  // next row of the spliced prompt embeddings, in order of appearance
            if (!spliced || (next + 1) * kHidden > spliced->size()) throw std::invalid_argument("te embed: missing spliced row");
            std::memcpy(&out[r * kHidden], spliced->data() + next * kHidden, kHidden * sizeof(float));
            ++next;
            continue;
        }
        if (id < 0 || std::size_t(id) >= im.embed_scale.size()) throw std::invalid_argument("te embed: token id");
        const float s = im.embed_scale[std::size_t(id)];
        const std::int8_t* q = im.embed_q.data() + std::size_t(id) * kHidden;
        for (unsigned c = 0; c < kHidden; ++c) out[r * kHidden + c] = round_bf16(float(q[c]) * s);
    }
    if (spliced && next * kHidden != spliced->size()) throw std::invalid_argument("te embed: unused spliced rows");
}
std::uint64_t TextEncoder::device_bytes() const noexcept { return impl_->bytes; }

double TextEncoder::expand_all_ms() {
    auto& im = *impl_;
    struct Event {
        hipEvent_t e = nullptr;
        Event() { ck(hipEventCreate(&e), "event"); }
        ~Event() { if (e) (void)hipEventDestroy(e); }
    } a, b;
    ck(hipEventRecord(a.e, im.stream), "record");
    for (const auto& L : im.layers) im.expand_layer(L);
    ck(hipEventRecord(b.e, im.stream), "record");
    ck(hipEventSynchronize(b.e), "sync");
    float ms = 0;
    ck(hipEventElapsedTime(&ms, a.e, b.e), "elapsed");
    return ms;
}

std::vector<float> TextEncoder::encode(const std::vector<std::int32_t>& ids, EncodeTimings* timings,
                                       const std::vector<float>& spliced) {
    auto& im = *impl_;
    const unsigned S = unsigned(ids.size());
    if (S == 0) throw std::invalid_argument("te encode: empty sequence");

    std::vector<float> x;
    embed_rows(ids, x, spliced.empty() ? nullptr : &spliced);
    EncodeInput in;
    in.embeds = std::move(x);
    return encode(in, timings);
}

std::vector<float> TextEncoder::encode(const EncodeInput& in, EncodeTimings* timings) {
    auto& im = *impl_;
    const unsigned S = unsigned(in.embeds.size() / kHidden);
    if (S == 0 || in.embeds.size() != std::size_t(S) * kHidden) throw std::invalid_argument("te encode: embeds");
    if (!in.positions.empty() && in.positions.size() != std::size_t(3) * S) throw std::invalid_argument("te encode: positions");
    const unsigned P = (S + 31U) / 32U * 32U;  // padded rows for Q/K/V
    const auto t0 = std::chrono::steady_clock::now();
    std::vector<float> x = in.embeds;
    im.taps.clear();
    // RoPE tables: angle = fp32(pos * fp32 inv_freq), cos/sin rounded from double. With 3-axis
    // positions (vision prompts), interleaved MRoPE: frequency f < 60 takes the H position when
    // f % 3 == 1, the W position when f % 3 == 2, the T position otherwise.
    std::vector<float> cosv(std::size_t(S) * 64), sinv(std::size_t(S) * 64);
    for (unsigned f = 0; f < 64; ++f) {
        const float inv = inv_freq(f);
        const unsigned axis = f < 60U && f % 3U == 1U ? 1U : f < 60U && f % 3U == 2U ? 2U : 0U;
        for (unsigned r = 0; r < S; ++r) {
            const float pos = in.positions.empty() ? float(r) : in.positions[std::size_t(axis) * S + r];
            const float ang = pos * inv;
            cosv[std::size_t(r) * 64 + f] = float(std::cos(double(ang)));
            sinv[std::size_t(r) * 64 + f] = float(std::sin(double(ang)));
        }
    }
    // DeepStack: rows and per-layer additions
    std::vector<DeviceBuffer> deep;
    DeviceBuffer deep_rows;
    if (in.deepstack.size() > 3) throw std::invalid_argument("te encode: more than 3 DeepStack additions");
    if (!in.deepstack.empty()) {
        const std::size_t nv = in.visual_rows.size();
        std::vector<std::uint32_t> sorted(in.visual_rows.begin(), in.visual_rows.end());
        std::sort(sorted.begin(), sorted.end());
        if (std::adjacent_find(sorted.begin(), sorted.end()) != sorted.end()) throw std::invalid_argument("te encode: duplicate visual row");
        for (const auto& d : in.deepstack) {
            if (d.size() != nv * kHidden) throw std::invalid_argument("te encode: deepstack size");
            deep.push_back(upload(d.data(), d.size() * sizeof(float)));
        }
        std::vector<std::uint32_t> rows(in.visual_rows.begin(), in.visual_rows.end());
        for (const auto r : rows) if (r >= S) throw std::invalid_argument("te encode: visual row");
        deep_rows = upload(rows.data(), rows.size() * sizeof(std::uint32_t));
    }
    DeviceBuffer dx = upload(x.data(), x.size() * sizeof(float));
    DeviceBuffer dcos = upload(cosv.data(), cosv.size() * sizeof(float));
    DeviceBuffer dsin = upload(sinv.data(), sinv.size() * sizeof(float));
    DeviceBuffer a16(std::size_t(S) * kFfn * 2 * (im.split ? 2 : 1));
    const auto plane = [&](unsigned k) { return im.split ? std::size_t(S) * k : std::size_t(0); };
    DeviceBuffer qkv(std::size_t(S) * kQkv * 4);
    DeviceBuffer gu(std::size_t(S) * 2 * kFfn * 4);
    const std::size_t sp = im.split ? 2 : 1, qpl = im.split ? std::size_t(kHeads) * P * kHeadDim : 0,
                      kvpl = im.split ? std::size_t(kKvHeads) * P * kHeadDim : 0;
    DeviceBuffer q16(sp * kHeads * P * kHeadDim * 2), k16(sp * kKvHeads * P * kHeadDim * 2),
        v16(sp * kKvHeads * P * kHeadDim * 2);
    ck(hipMemsetAsync(q16.p, 0, q16.n, im.stream), "memset");
    ck(hipMemsetAsync(k16.p, 0, k16.n, im.stream), "memset");
    ck(hipMemsetAsync(v16.p, 0, v16.n, im.stream), "memset");
    ck(hipStreamSynchronize(im.stream), "sync");
    const auto t1 = std::chrono::steady_clock::now();

    auto* xa = a16.as<_Float16>();
    // debug stop (te_debug_stop): download an intermediate of layer debug_layer and return it
    // hi plane values, followed (split) by the lo plane values: [S][k] then [S][k]
    const auto panels_rows = [&](unsigned k) {
        const std::size_t np = im.split ? 2 : 1, n = std::size_t(S) * k;
        std::vector<_Float16> h(np * n);
        ck(hipStreamSynchronize(im.stream), "sync");
        ck(hipMemcpy(h.data(), a16.p, h.size() * 2, hipMemcpyDeviceToHost), "download");
        std::vector<float> o(h.size());
        for (std::size_t pl = 0; pl < np; ++pl)
            for (unsigned r = 0; r < S; ++r)
                for (unsigned c = 0; c < k; ++c)
                    o[pl * n + std::size_t(r) * k + c] = float(h[pl * n + (std::size_t(c / 16) * S + r) * 16 + c % 16]);
        return o;
    };
    const auto f32_rows = [&](const DeviceBuffer& b, std::size_t n) {
        std::vector<float> o(n);
        ck(hipStreamSynchronize(im.stream), "sync");
        ck(hipMemcpy(o.data(), b.p, n * 4, hipMemcpyDeviceToHost), "download");
        return o;
    };
    const bool sub = im.tap_sub && im.tap_row >= 0 && unsigned(im.tap_row) < S;
    DeviceBuffer tapbuf(sub ? std::size_t(kFfn) * 4 : 0);
    const auto tap_panel = [&](unsigned k) {
        hipLaunchKernelGGL(panel_row, dim3((k + 255U) / 256U), dim3(256), 0, im.stream, a16.as<_Float16>(), S, k,
                           unsigned(im.tap_row), plane(k), tapbuf.as<float>());
        launched("panel_row");
        std::vector<float> row(k);
        ck(hipStreamSynchronize(im.stream), "sync");
        ck(hipMemcpy(row.data(), tapbuf.p, k * 4, hipMemcpyDeviceToHost), "tap");
        im.taps.insert(im.taps.end(), row.begin(), row.end());
    };
    const auto tap_x = [&]() {
        std::vector<float> row(kHidden);
        ck(hipStreamSynchronize(im.stream), "sync");
        ck(hipMemcpy(row.data(), dx.as<float>() + std::size_t(im.tap_row) * kHidden, kHidden * 4, hipMemcpyDeviceToHost), "tap");
        im.taps.insert(im.taps.end(), row.begin(), row.end());
    };
    for (const auto& L : im.layers) {
        const int lidx = int(&L - im.layers.data());
        if (lidx < im.replay_first) continue;
        const bool dbg = lidx == im.debug_layer;
        im.expand_layer(L);
        if (!(im.replay_ffn && lidx == im.replay_first)) {
            hipLaunchKernelGGL(rmsnorm_panels, dim3(S), dim3(256), 0, im.stream, dx.as<float>(), L.attn_norm.as<float>(), S, xa, plane(kHidden));
            launched("rmsnorm");
            if (sub) tap_panel(kHidden);  // attention norm output (qkv GEMM input)
            if (dbg && im.debug_stage == 1) return panels_rows(kHidden);
            im.gemm<false>(im.w_qkv.as<_Float16>(), xa, S, kQkv, kHidden, L.scale_qkv.as<float>(), qkv.as<float>());
            if (dbg && im.debug_stage == 2) return f32_rows(qkv, std::size_t(S) * kQkv);
            hipLaunchKernelGGL(qk_norm_rope, dim3(S, kHeads + 2 * kKvHeads), dim3(kHeadDim), 0, im.stream, qkv.as<float>(),
                               L.q_norm.as<float>(), L.k_norm.as<float>(), dcos.as<float>(), dsin.as<float>(), P,
                               q16.as<_Float16>(), k16.as<_Float16>(), v16.as<_Float16>(), qpl, kvpl);
            launched("qk_norm_rope");
            if (dbg && im.debug_stage == 3) {  // q rows [S][64*128]
                std::vector<_Float16> h(q16.n / 2);
                ck(hipStreamSynchronize(im.stream), "sync");
                ck(hipMemcpy(h.data(), q16.p, q16.n, hipMemcpyDeviceToHost), "download");
                std::vector<float> o(std::size_t(S) * kAttn);
                for (unsigned hh = 0; hh < kHeads; ++hh)
                    for (unsigned r = 0; r < S; ++r)
                        for (unsigned d = 0; d < kHeadDim; ++d)
                            o[std::size_t(r) * kAttn + hh * kHeadDim + d] = float(h[(std::size_t(hh) * P + r) * kHeadDim + d]);
                return o;
            }
            if (im.split)
                hipLaunchKernelGGL((attention_kernel<kHeadDim, kHeads / kKvHeads, true, true>), dim3((S + 15U) / 16U, kKvHeads),
                                   dim3(32 * (kHeads / kKvHeads)), 0, im.stream, q16.as<_Float16>(), k16.as<_Float16>(),
                                   v16.as<_Float16>(), S, P, 0.08838834764831845F, kHeadDim, L.o_prescale.as<float>(), xa,
                                   plane(kAttn), qpl, kvpl);
            else
                hipLaunchKernelGGL((attention_kernel<kHeadDim, kHeads / kKvHeads, true, false>), dim3((S + 15U) / 16U, kKvHeads),
                                   dim3(32 * (kHeads / kKvHeads)), 0, im.stream, q16.as<_Float16>(), k16.as<_Float16>(),
                                   v16.as<_Float16>(), S, P, 0.08838834764831845F, kHeadDim, L.o_prescale.as<float>(), xa,
                                   plane(kAttn), qpl, kvpl);
            launched("attention");
            if (dbg && im.debug_stage == 4) return panels_rows(kAttn);
            if (sub) tap_panel(kAttn);  // o_proj input (attention output x pre-scale)
            im.gemm<true>(im.w_o.as<_Float16>(), xa, S, kHidden, kAttn, L.scale_o.as<float>(), dx.as<float>());
            if (sub) tap_x();  // residual after the attention block
            if (dbg && im.debug_stage == 5) return f32_rows(dx, std::size_t(S) * kHidden);
        }  // attention block
        hipLaunchKernelGGL(rmsnorm_panels, dim3(S), dim3(256), 0, im.stream, dx.as<float>(), L.ffn_norm.as<float>(), S, xa, plane(kHidden));
        launched("rmsnorm");
        if (sub) tap_panel(kHidden);  // FFN norm output (gate/up GEMM input)
        im.gemm<false>(im.w_gu.as<_Float16>(), xa, S, 2 * kFfn, kHidden, L.scale_gu.as<float>(), gu.as<float>());
        const std::size_t n = std::size_t(S) * kFfn;
        hipLaunchKernelGGL(swiglu_panels, dim3(unsigned((n + 255) / 256)), dim3(256), 0, im.stream, gu.as<float>(),
                           L.down_prescale.as<float>(), S, xa, plane(kFfn));
        launched("swiglu");
        if (sub) tap_panel(kFfn);  // down_proj input (SwiGLU x pre-scale)
        im.gemm<true>(im.w_down.as<_Float16>(), xa, S, kHidden, kFfn, L.scale_down.as<float>(), dx.as<float>());
        const std::size_t li = std::size_t(&L - im.layers.data());
        if (li < deep.size()) {
            const std::size_t n = in.visual_rows.size() * kHidden;
            hipLaunchKernelGGL(deepstack_add, dim3(unsigned((n + 255) / 256)), dim3(256), 0, im.stream, dx.as<float>(),
                               deep[li].as<float>(), deep_rows.as<std::uint32_t>(), unsigned(in.visual_rows.size()));
            launched("deepstack");
        }
        if (dbg) return f32_rows(dx, std::size_t(S) * kHidden);
        if (im.tap_row >= 0 && unsigned(im.tap_row) < S) {
            std::vector<float> row(kHidden);
            ck(hipStreamSynchronize(im.stream), "sync");
            ck(hipMemcpy(row.data(), dx.as<float>() + std::size_t(im.tap_row) * kHidden, kHidden * 4, hipMemcpyDeviceToHost), "tap");
            im.taps.insert(im.taps.end(), row.begin(), row.end());
        }
    }
    ck(hipStreamSynchronize(im.stream), "sync");
    const auto t2 = std::chrono::steady_clock::now();
    ck(hipMemcpy(x.data(), dx.p, x.size() * sizeof(float), hipMemcpyDeviceToHost), "download");
    const auto t3 = std::chrono::steady_clock::now();
    if (timings) {
        timings->upload_ms = std::chrono::duration<double, std::milli>(t1 - t0).count();
        timings->forward_ms = std::chrono::duration<double, std::milli>(t2 - t1).count();
        timings->download_ms = std::chrono::duration<double, std::milli>(t3 - t2).count();
    }
    return x;
}

// =============================================================================================
// Row-count invariance probes (tests only): run one kernel on the first `rows` rows of random
// inputs and return the outputs, so that a caller can compare rows 0..r-1 of two row counts.
namespace probe {

std::vector<float> wmma_rows(const std::vector<float>& a16x16, const std::vector<float>& b16x16, const float* c16x16) {
    // one 16x16x16 WMMA, A row-major [16][16], B [n][k] [16][16] -> D row-major [16][16]
    struct K {
        static __global__ void run(const _Float16* a, const _Float16* b, const float* cin, float* d) {
            const unsigned lane = threadIdx.x;
            Half16 av, bv;
            for (unsigned j = 0; j < 16; ++j) { av[j] = a[(lane % 16) * 16 + j]; bv[j] = b[(lane % 16) * 16 + j]; }
            Float8 c{};
            for (unsigned e = 0; e < 8; ++e) c[e] = cin[(2 * e + lane / 16) * 16 + lane % 16];
            c = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(av, bv, c);
            for (unsigned e = 0; e < 8; ++e) d[(2 * e + lane / 16) * 16 + lane % 16] = c[e];
        }
    };
    std::vector<_Float16> ah(256), bh(256);
    for (int i = 0; i < 256; ++i) { ah[i] = static_cast<_Float16>(a16x16[i]); bh[i] = static_cast<_Float16>(b16x16[i]); }
    std::vector<float> cz(256, 0.0F);
    if (c16x16) cz.assign(c16x16, c16x16 + 256);
    DeviceBuffer da = upload(ah.data(), 512), db = upload(bh.data(), 512), dc = upload(cz.data(), 1024), dd(1024);
    hipLaunchKernelGGL(K::run, dim3(1), dim3(32), 0, nullptr, da.as<_Float16>(), db.as<_Float16>(), dc.as<float>(), dd.as<float>());
    launched("probe wmma");
    std::vector<float> d(256);
    ck(hipMemcpy(d.data(), dd.p, 1024, hipMemcpyDeviceToHost), "download");
    return d;
}

// LM attention (head dim 128, group 8, causal) on q [64][rows][128], k/v [8][rows][128] FP32 values;
// split or plain; returns hi + lo of the output panels as rows [rows][8192].
std::vector<float> attention_rows(const std::vector<float>& q, const std::vector<float>& k, const std::vector<float>& v,
                                  unsigned rows, bool split, int variant) {
    const unsigned P = (rows + 31U) / 32U * 32U;
    const std::size_t qn = std::size_t(kHeads) * P * kHeadDim, kn = std::size_t(kKvHeads) * P * kHeadDim;
    const std::size_t np = split ? 2 : 1;
    std::vector<_Float16> qh(np * qn, _Float16(0)), kh(np * kn, _Float16(0)), vh(np * kn, _Float16(0));
    const auto fill = [&](const std::vector<float>& src, std::vector<_Float16>& dst, unsigned heads, std::size_t pn) {
        for (unsigned h = 0; h < heads; ++h)
            for (unsigned r = 0; r < rows; ++r)
                for (unsigned d = 0; d < kHeadDim; ++d) {
                    const float x = src[(std::size_t(h) * rows + r) * kHeadDim + d];
                    const std::size_t i = (std::size_t(h) * P + r) * kHeadDim + d;
                    const _Float16 hi = static_cast<_Float16>(x);
                    dst[i] = hi;
                    if (split) dst[i + pn] = static_cast<_Float16>((x - static_cast<float>(hi)) * kLoScale);
                }
    };
    fill(q, qh, kHeads, qn);
    fill(k, kh, kKvHeads, kn);
    fill(v, vh, kKvHeads, kn);
    DeviceBuffer dq = upload(qh.data(), qh.size() * 2), dk = upload(kh.data(), kh.size() * 2), dv = upload(vh.data(), vh.size() * 2);
    const std::size_t on = std::size_t(rows) * kAttn;
    DeviceBuffer dout(np * on * 2);
    std::vector<float> pres(kAttn, 1.0F);
    DeviceBuffer dp = upload(pres.data(), pres.size() * 4);
    if (split && variant == 1)  // scores split only
        hipLaunchKernelGGL((attention_kernel<kHeadDim, kHeads / kKvHeads, true, true, true, false>), dim3((rows + 15U) / 16U, kKvHeads),
                           dim3(256), 0, nullptr, dq.as<_Float16>(), dk.as<_Float16>(), dv.as<_Float16>(), rows, P, 0.08838834764831845F,
                           kHeadDim, dp.as<float>(), dout.as<_Float16>(), on, qn, kn);
    else if (split && variant == 2)  // P.V split only
        hipLaunchKernelGGL((attention_kernel<kHeadDim, kHeads / kKvHeads, true, true, false, true>), dim3((rows + 15U) / 16U, kKvHeads),
                           dim3(256), 0, nullptr, dq.as<_Float16>(), dk.as<_Float16>(), dv.as<_Float16>(), rows, P, 0.08838834764831845F,
                           kHeadDim, dp.as<float>(), dout.as<_Float16>(), on, qn, kn);
    else if (split)
        hipLaunchKernelGGL((attention_kernel<kHeadDim, kHeads / kKvHeads, true, true>), dim3((rows + 15U) / 16U, kKvHeads), dim3(256), 0,
                           nullptr, dq.as<_Float16>(), dk.as<_Float16>(), dv.as<_Float16>(), rows, P, 0.08838834764831845F, kHeadDim,
                           dp.as<float>(), dout.as<_Float16>(), on, qn, kn);
    else
        hipLaunchKernelGGL((attention_kernel<kHeadDim, kHeads / kKvHeads, true, false>), dim3((rows + 15U) / 16U, kKvHeads), dim3(256), 0,
                           nullptr, dq.as<_Float16>(), dk.as<_Float16>(), dv.as<_Float16>(), rows, P, 0.08838834764831845F, kHeadDim,
                           dp.as<float>(), dout.as<_Float16>(), std::size_t(0), qn, kn);
    launched("probe attention");
    std::vector<_Float16> oh(np * on);
    ck(hipMemcpy(oh.data(), dout.p, oh.size() * 2, hipMemcpyDeviceToHost), "download");
    std::vector<float> o(on);
    for (unsigned r = 0; r < rows; ++r)
        for (unsigned c = 0; c < kAttn; ++c) {
            const std::size_t i = (std::size_t(c / 16) * rows + r) * 16 + c % 16;
            o[std::size_t(r) * kAttn + c] = float(oh[i]) + (split ? float(oh[i + on]) / kLoScale : 0.0F);
        }
    return o;
}

std::vector<float> attention_taps(const std::vector<float>& q, const std::vector<float>& k, const std::vector<float>& v,
                                  unsigned rows, bool split, unsigned row) {
    if (row >= rows) throw std::runtime_error("te attention_taps: row out of range");
    // the kernel writes one 512-float record per key block it visits: at most ceil(rows / 32) blocks
    DeviceBuffer d(std::size_t((rows + 31U) / 32U) * 512 * 4);
    ck(hipMemset(d.p, 0xFF, d.n), "memset");
    struct Reset {  // the device symbol never outlives the buffer, also on exceptions
        bool armed = false;
        ~Reset() {
            if (!armed) return;
            float* none = nullptr;
            (void)hipDeviceSynchronize();
            (void)hipMemcpyToSymbol(HIP_SYMBOL(g_att_dbg), &none, sizeof none);
        }
    } reset;
    float* ptr = d.as<float>();
    ck(hipMemcpyToSymbol(HIP_SYMBOL(g_att_dbg_row), &row, sizeof row), "symbol");
    reset.armed = true;
    ck(hipMemcpyToSymbol(HIP_SYMBOL(g_att_dbg), &ptr, sizeof ptr), "symbol");
    (void)attention_rows(q, k, v, rows, split, 0);
    float* none = nullptr;
    ck(hipDeviceSynchronize(), "sync");
    ck(hipMemcpyToSymbol(HIP_SYMBOL(g_att_dbg), &none, sizeof none), "symbol");
    reset.armed = false;
    std::vector<float> out(d.n / 4);
    ck(hipMemcpy(out.data(), d.p, d.n, hipMemcpyDeviceToHost), "download");
    return out;
}

// GEMM (split or plain) of x [rows][k] FP32 with random FP16 weights [n][k] -> out [rows][n].
std::vector<float> gemm_rows(const std::vector<float>& x, const std::vector<float>& w, unsigned rows, unsigned n, unsigned k,
                             bool split) {
    const std::size_t np = split ? 2 : 1, an = std::size_t(rows) * k;
    std::vector<_Float16> ah(np * an), wh(std::size_t(n) * k);
    for (unsigned r = 0; r < rows; ++r)
        for (unsigned c = 0; c < k; ++c) {
            const float v = x[std::size_t(r) * k + c];
            const std::size_t i = (std::size_t(c / 16) * rows + r) * 16 + c % 16;
            const _Float16 hi = static_cast<_Float16>(v);
            ah[i] = hi;
            if (split) ah[i + an] = static_cast<_Float16>((v - float(hi)) * kLoScale);
        }
    for (unsigned j = 0; j < n; ++j)
        for (unsigned c = 0; c < k; ++c)
            wh[((std::size_t(j / 16) * (k / 16) + c / 16) * 256) + (j % 16) * 16 + c % 16] = static_cast<_Float16>(w[std::size_t(j) * k + c]);
    DeviceBuffer da = upload(ah.data(), ah.size() * 2), dw = upload(wh.data(), wh.size() * 2), dout(std::size_t(rows) * n * 4);
    std::vector<float> sc(n, 1.0F);
    DeviceBuffer ds = upload(sc.data(), sc.size() * 4);
    const dim3 grid(split ? (n + 127U) / 128U : (n + 255U) / 256U, (rows + 127U) / 128U);
    if (split)
        hipLaunchKernelGGL((gemm_kernel<false, true>), grid, dim3(256), 0, nullptr, dw.as<_Float16>(), da.as<_Float16>(), rows, n, k,
                           ds.as<float>(), static_cast<const float*>(nullptr), dout.as<float>());
    else
        hipLaunchKernelGGL((gemm_kernel<false, false>), grid, dim3(256), 0, nullptr, dw.as<_Float16>(), da.as<_Float16>(), rows, n, k,
                           ds.as<float>(), static_cast<const float*>(nullptr), dout.as<float>());
    launched("probe gemm");
    std::vector<float> o(std::size_t(rows) * n);
    ck(hipMemcpy(o.data(), dout.p, o.size() * 4, hipMemcpyDeviceToHost), "download");
    return o;
}

}  // namespace probe

// =============================================================================================
// Vision tower
namespace {

struct VLinear {
    DeviceBuffer panels, scale, bias;
    unsigned n = 0, k = 0, stride = 0;
};

float host_bf16(std::uint16_t b) { return bf16_to_float(b); }

VLinear load_vlinear(const SafetensorsFile& f, const std::string& base, hipStream_t q, std::vector<std::int64_t> shape) {
    VLinear l;
    l.n = unsigned(shape.at(0));
    std::int64_t k = 1;
    for (std::size_t i = 1; i < shape.size(); ++i) k *= shape[i];
    l.k = unsigned(k);
    l.stride = (l.k + 31U) / 32U * 32U;
    const auto raw = f.read_vector<std::uint16_t>(base + ".weight", "BF16", shape);
    float mx = 0.0F;
    for (const auto b : raw) mx = std::fmax(mx, std::fabs(host_bf16(b)));
    // largest power of two with max * 2^shift <= 2^15 (more f16 normal range for small weights)
    int shift = 0;
    if (mx > 0.0F) shift = int(std::floor(std::log2(32768.0 / double(mx))));
    shift = std::min(shift, 24);
    const float mult = std::ldexp(1.0F, shift);
    DeviceBuffer src = upload(raw.data(), raw.size() * 2);
    const std::size_t n16 = (l.n + 15U) / 16U * 16U;
    l.panels = DeviceBuffer(n16 * l.stride * 2);
    const std::size_t blocks = n16 * (l.stride / 16U);
    hipLaunchKernelGGL(bf16_panels, dim3(unsigned((blocks + 255) / 256)), dim3(256), 0, q, src.as<std::uint16_t>(), l.n, l.k,
                       l.stride, mult, l.panels.as<_Float16>());
    launched("bf16_panels");
    ck(hipStreamSynchronize(q), "sync");
    std::vector<float> sc(l.n, std::ldexp(1.0F, -shift));
    l.scale = upload(sc.data(), sc.size() * 4);
    l.bias = upload_bf16_as_float(f, base + ".bias", shape.at(0));
    return l;
}

struct VBlock {
    DeviceBuffer n1w, n1b, n2w, n2b;
    VLinear qkv, proj, fc1, fc2;
};
struct VMerger {
    DeviceBuffer nw, nb;
    VLinear fc1, fc2;
    unsigned norm_width = 0;
};

}  // namespace

struct VisionTower::Impl {
    hipStream_t stream = nullptr;
    VLinear patch;
    std::vector<float> pos_embed;  // [2304][1152] bf16 values as float
    std::vector<VBlock> blocks;
    VMerger merger;
    std::vector<VMerger> deep;
    std::uint64_t bytes = 0;

    bool split = true;  // vision tower: split-A by default (env STRIX_H3_TE_VSPLIT=0 disables)
    std::size_t plane(unsigned rows, unsigned stride) const { return split ? std::size_t(rows) * stride : 0; }
    void gemm(const VLinear& l, const _Float16* x, unsigned rows, float* out, bool acc) const {
        const dim3 grid(split ? (l.n + 127U) / 128U : (l.n + 255U) / 256U, (rows + 127U) / 128U);
        const auto* w = l.panels.as<_Float16>();
        if (acc && split) hipLaunchKernelGGL((gemm_kernel<true, true>), grid, dim3(256), 0, stream, w, x, rows, l.n, l.stride, l.scale.as<float>(), l.bias.as<float>(), out);
        else if (acc) hipLaunchKernelGGL((gemm_kernel<true, false>), grid, dim3(256), 0, stream, w, x, rows, l.n, l.stride, l.scale.as<float>(), l.bias.as<float>(), out);
        else if (split) hipLaunchKernelGGL((gemm_kernel<false, true>), grid, dim3(256), 0, stream, w, x, rows, l.n, l.stride, l.scale.as<float>(), l.bias.as<float>(), out);
        else hipLaunchKernelGGL((gemm_kernel<false, false>), grid, dim3(256), 0, stream, w, x, rows, l.n, l.stride, l.scale.as<float>(), l.bias.as<float>(), out);
        launched("vision gemm");
    }
    void layernorm(const float* x, unsigned rows, unsigned width, const DeviceBuffer& w, const DeviceBuffer& b,
                   unsigned group, _Float16* out) const {
        hipLaunchKernelGGL(layernorm_panels, dim3(rows), dim3(256), 0, stream, x, width, w.as<float>(), b.as<float>(), group,
                           rows / group, out, plane(rows / group, width * group));
        launched("layernorm");
    }
    template <bool Tanh>
    void gelu(const float* x, unsigned rows, unsigned n, unsigned stride, _Float16* out) const {
        const std::size_t c = std::size_t(rows) * stride;
        hipLaunchKernelGGL(gelu_panels<Tanh>, dim3(unsigned((c + 255) / 256)), dim3(256), 0, stream, x, rows, n, stride, out,
                           plane(rows, stride));
        launched("gelu");
    }
    void merge(const VMerger& m, const float* x, unsigned patches, _Float16* a, float* mid, float* out) const {
        const unsigned M = patches / 4U;
        if (m.norm_width == 1152U) layernorm(x, patches, 1152U, m.nw, m.nb, 4U, a);
        else layernorm(x, M, 4608U, m.nw, m.nb, 1U, a);
        gemm(m.fc1, a, M, mid, false);
        gelu<false>(mid, M, m.fc1.n, m.fc2.stride, a);
        gemm(m.fc2, a, M, out, false);
    }
};

VisionTower::VisionTower() : impl_(std::make_unique<Impl>()) {}
VisionTower::~VisionTower() {
    if (impl_ && impl_->stream) (void)hipStreamDestroy(impl_->stream);
}

std::unique_ptr<VisionTower> VisionTower::load(const std::string& dir) {
    PackCheck check(dir, {"te-vision.safetensors"});
    std::unique_ptr<VisionTower> vt(new VisionTower());
    auto& im = *vt->impl_;
    ck(hipStreamCreateWithFlags(&im.stream, hipStreamNonBlocking), "stream");
    if (const char* sp = std::getenv("STRIX_H3_TE_VSPLIT"); sp && sp[0] == '0') im.split = false;
    SafetensorsFile f(dir + "/te-vision.safetensors");
    im.patch = load_vlinear(f, "v.patch_embed.proj", im.stream, {1152, 3, 2, 16, 16});
    {
        const auto raw = f.read_vector<std::uint16_t>("v.pos_embed.weight", "BF16", {2304, 1152});
        im.pos_embed.resize(raw.size());
        for (std::size_t i = 0; i < raw.size(); ++i) im.pos_embed[i] = host_bf16(raw[i]);
    }
    for (int b = 0; b < 27; ++b) {
        const std::string p = "v.blocks." + std::to_string(b) + ".";
        VBlock blk;
        blk.n1w = upload_bf16_as_float(f, p + "norm1.weight", 1152);
        blk.n1b = upload_bf16_as_float(f, p + "norm1.bias", 1152);
        blk.n2w = upload_bf16_as_float(f, p + "norm2.weight", 1152);
        blk.n2b = upload_bf16_as_float(f, p + "norm2.bias", 1152);
        blk.qkv = load_vlinear(f, p + "attn.qkv", im.stream, {3456, 1152});
        blk.proj = load_vlinear(f, p + "attn.proj", im.stream, {1152, 1152});
        blk.fc1 = load_vlinear(f, p + "mlp.linear_fc1", im.stream, {4304, 1152});
        blk.fc2 = load_vlinear(f, p + "mlp.linear_fc2", im.stream, {1152, 4304});
        for (const auto* l : {&blk.qkv, &blk.proj, &blk.fc1, &blk.fc2}) im.bytes += l->panels.n;
        im.blocks.push_back(std::move(blk));
    }
    const auto merger = [&](const std::string& p, unsigned width) {
        VMerger m;
        m.nw = upload_bf16_as_float(f, p + ".norm.weight", width);
        m.nb = upload_bf16_as_float(f, p + ".norm.bias", width);
        m.fc1 = load_vlinear(f, p + ".linear_fc1", im.stream, {4608, 4608});
        m.fc2 = load_vlinear(f, p + ".linear_fc2", im.stream, {5120, 4608});
        m.norm_width = width;
        im.bytes += m.fc1.panels.n + m.fc2.panels.n;
        return m;
    };
    im.merger = merger("v.merger", 1152U);
    for (int d = 0; d < 3; ++d) im.deep.push_back(merger("v.deepstack_merger_list." + std::to_string(d), 4608U));
    check.finish();
    return vt;
}

std::uint64_t VisionTower::device_bytes() const noexcept { return impl_->bytes; }

namespace {

float to_bf16(float f) { return round_bf16(f); }

// torch.linspace(0, end, steps) in fp32 (symmetric evaluation)
std::vector<float> linspace(float end, int steps) {
    std::vector<float> v(static_cast<std::size_t>(steps));
    if (steps == 1) { v[0] = 0.0F; return v; }
    const float step = end / float(steps - 1);
    const int half = steps / 2;
    for (int i = 0; i < steps; ++i) v[std::size_t(i)] = i < half ? 0.0F + step * float(i) : end - step * float(steps - i - 1);
    return v;
}

}  // namespace

VisionOutput VisionTower::run(const Patches& p, double* ms) {
    auto& im = *impl_;
    const unsigned gh = unsigned(p.grid_h), gw = unsigned(p.grid_w), N = gh * gw, M = N / 4U;
    const unsigned NP = (N + 31U) / 32U * 32U;
    if (N == 0 || gh % 2U || gw % 2U || p.data.size() != std::size_t(N) * 1536U) throw std::invalid_argument("vision: patches");
    const auto t0 = std::chrono::steady_clock::now();
    // position embedding: bilinear over the 48x48 table, arithmetic in bf16 as the reference does
    std::vector<float> pos(std::size_t(N) * 1152U);
    {
        constexpr int G = 48;
        const auto hs = linspace(float(G - 1), int(gh)), ws = linspace(float(G - 1), int(gw));
        std::vector<float> grid(std::size_t(gh) * gw * 1152U);
        for (unsigned y = 0; y < gh; ++y)
            for (unsigned x = 0; x < gw; ++x) {
                const int hf = int(hs[y]), wf = int(ws[x]);
                const int hc = std::min(hf + 1, G - 1), wc = std::min(wf + 1, G - 1);
                const float dh = hs[y] - float(hf), dw = ws[x] - float(wf);
                const float wt[4] = {to_bf16((1.0F - dh) * (1.0F - dw)), to_bf16((1.0F - dh) * dw), to_bf16(dh * (1.0F - dw)),
                                     to_bf16(dh * dw)};
                const int idx[4] = {hf * G + wf, hf * G + wc, hc * G + wf, hc * G + wc};
                float* dst = &grid[(std::size_t(y) * gw + x) * 1152U];
                for (unsigned c = 0; c < 1152U; ++c) {
                    float acc = 0.0F;
                    for (int j = 0; j < 4; ++j) {
                        const float term = to_bf16(im.pos_embed[std::size_t(idx[j]) * 1152U + c] * wt[j]);
                        acc = j == 0 ? term : to_bf16(acc + term);
                    }
                    dst[c] = acc;
                }
            }
        std::size_t row = 0;
        for (unsigned bh = 0; bh < gh / 2; ++bh)
            for (unsigned bw = 0; bw < gw / 2; ++bw)
                for (unsigned mh = 0; mh < 2; ++mh)
                    for (unsigned mw = 0; mw < 2; ++mw, ++row)
                        std::memcpy(&pos[row * 1152U], &grid[((std::size_t(bh) * 2 + mh) * gw + bw * 2 + mw) * 1152U], 1152U * 4);
    }
    // 2D rotary: 18 frequencies per axis (theta 1e4 over 36 dims), [row freqs | col freqs]
    std::vector<float> cosv(std::size_t(N) * 36), sinv(std::size_t(N) * 36);
    {
        float inv[18];
        // 1 / fp32(10000 ** fp32(2f / 36)): matches the reference FP32 table bitwise (18/18)
        for (int f = 0; f < 18; ++f) inv[f] = 1.0F / float(std::pow(10000.0, double(float(2 * f) / 36.0F)));
        std::size_t row = 0;
        for (unsigned bh = 0; bh < gh / 2; ++bh)
            for (unsigned bw = 0; bw < gw / 2; ++bw)
                for (unsigned mh = 0; mh < 2; ++mh)
                    for (unsigned mw = 0; mw < 2; ++mw, ++row) {
                        const float pr = float(bh * 2 + mh), pc = float(bw * 2 + mw);
                        for (int f = 0; f < 18; ++f) {
                            const float ar = pr * inv[f], ac = pc * inv[f];
                            cosv[row * 36 + f] = float(std::cos(double(ar)));
                            sinv[row * 36 + f] = float(std::sin(double(ar)));
                            cosv[row * 36 + 18 + f] = float(std::cos(double(ac)));
                            sinv[row * 36 + 18 + f] = float(std::sin(double(ac)));
                        }
                    }
    }
    DeviceBuffer dpatch = upload(p.data.data(), p.data.size() * 4);
    DeviceBuffer dpos = upload(pos.data(), pos.size() * 4);
    DeviceBuffer dcos = upload(cosv.data(), cosv.size() * 4), dsin = upload(sinv.data(), sinv.size() * 4);
    DeviceBuffer x(std::size_t(N) * 1152U * 4), a16(std::size_t(N) * 4608U * 2 * 2), mid(std::size_t(N) * 4608U * 4);
    const std::size_t vpl = im.split ? std::size_t(16) * NP * 80U : 0, vsp = im.split ? 2 : 1;
    DeviceBuffer q16(vsp * 16 * NP * 80U * 2), k16(vsp * 16 * NP * 80U * 2), v16(vsp * 16 * NP * 80U * 2);
    ck(hipMemsetAsync(q16.p, 0, q16.n, im.stream), "memset");
    ck(hipMemsetAsync(k16.p, 0, k16.n, im.stream), "memset");
    ck(hipMemsetAsync(v16.p, 0, v16.n, im.stream), "memset");
    std::vector<DeviceBuffer> deep_out;
    for (int d = 0; d < 3; ++d) deep_out.emplace_back(std::size_t(M) * 5120U * 4);
    DeviceBuffer merged(std::size_t(M) * 5120U * 4);
    auto* a = a16.as<_Float16>();
    {
        const std::size_t c = std::size_t(N) * im.patch.stride;
        hipLaunchKernelGGL(f32_panels, dim3(unsigned((c + 255) / 256)), dim3(256), 0, im.stream, dpatch.as<float>(), N,
                           im.patch.k, im.patch.stride, a, im.plane(N, im.patch.stride));
        launched("f32_panels");
    }
    im.gemm(im.patch, a, N, x.as<float>(), false);
    {
        const std::size_t c = std::size_t(N) * 1152U;
        hipLaunchKernelGGL(add_rows, dim3(unsigned((c + 255) / 256)), dim3(256), 0, im.stream, x.as<float>(), dpos.as<float>(), c);
        launched("add_rows");
    }
    int deep_i = 0;
    for (unsigned b = 0; b < im.blocks.size(); ++b) {
        const auto& B = im.blocks[b];
        im.layernorm(x.as<float>(), N, 1152U, B.n1w, B.n1b, 1U, a);
        im.gemm(B.qkv, a, N, mid.as<float>(), false);
        {
            const std::size_t c = std::size_t(N) * 3 * 16 * 80;
            hipLaunchKernelGGL(vision_qkv, dim3(unsigned((c + 255) / 256)), dim3(256), 0, im.stream, mid.as<float>(),
                               dcos.as<float>(), dsin.as<float>(), N, NP, q16.as<_Float16>(), k16.as<_Float16>(), v16.as<_Float16>(),
                               vpl);
            launched("vision_qkv");
        }
        if (im.split)
            hipLaunchKernelGGL((attention_kernel<80, 1, false, true>), dim3((N + 15U) / 16U, 16), dim3(32), 0, im.stream,
                               q16.as<_Float16>(), k16.as<_Float16>(), v16.as<_Float16>(), N, NP, 0.11785113019775792F, 72U,
                               static_cast<const float*>(nullptr), a, im.plane(N, 1152U), vpl, vpl);
        else
            hipLaunchKernelGGL((attention_kernel<80, 1, false, false>), dim3((N + 15U) / 16U, 16), dim3(32), 0, im.stream,
                               q16.as<_Float16>(), k16.as<_Float16>(), v16.as<_Float16>(), N, NP, 0.11785113019775792F, 72U,
                               static_cast<const float*>(nullptr), a, im.plane(N, 1152U), vpl, vpl);
        launched("vision attention");
        im.gemm(B.proj, a, N, x.as<float>(), true);
        im.layernorm(x.as<float>(), N, 1152U, B.n2w, B.n2b, 1U, a);
        im.gemm(B.fc1, a, N, mid.as<float>(), false);
        im.gelu<true>(mid.as<float>(), N, B.fc1.n, B.fc2.stride, a);
        im.gemm(B.fc2, a, N, x.as<float>(), true);
        if (b == 8 || b == 16 || b == 24) {
            im.merge(im.deep[std::size_t(deep_i)], x.as<float>(), N, a, mid.as<float>(), deep_out[std::size_t(deep_i)].as<float>());
            ++deep_i;
        }
    }
    im.merge(im.merger, x.as<float>(), N, a, mid.as<float>(), merged.as<float>());
    ck(hipStreamSynchronize(im.stream), "sync");
    VisionOutput out;
    out.merged.resize(std::size_t(M) * 5120U);
    ck(hipMemcpy(out.merged.data(), merged.p, merged.n, hipMemcpyDeviceToHost), "download");
    for (int d = 0; d < 3; ++d) {
        out.deep[d].resize(std::size_t(M) * 5120U);
        ck(hipMemcpy(out.deep[d].data(), deep_out[std::size_t(d)].p, deep_out[std::size_t(d)].n, hipMemcpyDeviceToHost), "download");
    }
    if (ms) *ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
    return out;
}

std::vector<float> encode_presented(TextEncoder& te, VisionTower* vt, const Presented& pres,
                                    const std::vector<Frames>& blocks, const std::vector<float>& spliced, EncodeTimings* t,
                                    double* vision_ms) {
    std::vector<Patches> patches;
    for (const auto& f : blocks) patches.push_back(make_patches(f));
    const auto lay = expand_layout(pres.ids, patches);
    EncodeInput in;
    in.embeds.resize(lay.ids.size() * kHidden);
    in.positions = lay.positions;
    // text rows via the encoder's lookup; vision rows from the tower
    std::vector<std::int32_t> text_ids;
    for (const auto id : lay.ids) text_ids.push_back(id == kVisionSlot ? 0 : id);
    te.embed_rows(text_ids, in.embeds, spliced.empty() ? nullptr : &spliced);
    if (!patches.empty() && vt == nullptr) throw std::invalid_argument("encode_presented: vision blocks without a tower");
    in.deepstack.assign(3, {});
    double vms = 0;
    for (std::size_t b = 0; b < patches.size(); ++b) {
        double ms = 0;
        const auto vo = vt->run(patches[b], &ms);
        vms += ms;
        const auto& span = lay.spans[b];
        std::memcpy(&in.embeds[std::size_t(span.index) * kHidden], vo.merged.data(), vo.merged.size() * 4);
        for (std::uint32_t r = 0; r < span.size; ++r) in.visual_rows.push_back(span.index + r);
        for (int d = 0; d < 3; ++d) in.deepstack[std::size_t(d)].insert(in.deepstack[std::size_t(d)].end(), vo.deep[d].begin(), vo.deep[d].end());
    }
    if (patches.empty()) in.deepstack.clear();
    if (vision_ms) *vision_ms = vms;
    return te.encode(in, t);
}

PromptEmbedding read_prompt_embedding(const std::string& path, const std::string& key) {
    SafetensorsFile f(path);
    if (!f.has(key)) throw PackError("prompt embedding: no tensor " + key + " in " + path);
    const auto& t = f.info(key);
    if (t.shape.size() != 2 || t.shape[1] != kHidden || t.shape[0] <= 0) throw PackError("prompt embedding: " + key + " is not [rows, 5120]");
    PromptEmbedding e;
    e.rows = int(t.shape[0]);
    if (t.dtype == "BF16") {
        const auto raw = f.read_vector<std::uint16_t>(key, "BF16", t.shape);
        e.data.resize(raw.size());
        for (std::size_t i = 0; i < raw.size(); ++i) e.data[i] = bf16_to_float(raw[i]);
    } else if (t.dtype == "F32") {
        e.data = f.read_vector<float>(key, "F32", t.shape);
    } else {
        throw PackError("prompt embedding: unsupported dtype " + t.dtype);
    }
    return e;
}

}  // namespace strix::h3::te
